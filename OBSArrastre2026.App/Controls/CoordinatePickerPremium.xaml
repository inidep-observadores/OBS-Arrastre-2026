<UserControl x:Class="OBSArrastre2026.App.Controls.CoordinatePickerPremium"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             Focusable="True"
             IsTabStop="False"
             KeyboardNavigation.TabNavigation="Continue"
             GotFocus="UserControl_GotFocus"
             d:DesignHeight="40" d:DesignWidth="180">
    <Grid>
        <Border x:Name="MainBorder"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1.5"
                CornerRadius="0"
                SnapsToDevicePixels="True">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsFocused, ElementName=CoordInput}" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            <Setter Property="BorderThickness" Value="2"/>
                            <Setter Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect BlurRadius="8" ShadowDepth="0" Color="{Binding Color, Source={StaticResource AccentBrush}}" Opacity="0.3"/>
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding EsCompacto, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                            <Setter Property="Padding" Value="0"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox x:Name="CoordInput"
                         Background="Transparent"
                         BorderThickness="0"
                         FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                         Foreground="{DynamicResource PrimaryTextBrush}"
                         CaretBrush="{DynamicResource AccentBrush}"
                         VerticalContentAlignment="Center"
                         TextChanged="CoordInput_TextChanged"
                         PreviewKeyDown="CoordInput_PreviewKeyDown"
                         LostFocus="CoordInput_LostFocus"
                         MaxLength="12">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Setter Property="Padding" Value="12,8" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding EsCompacto, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                    <Setter Property="Padding" Value="6,4" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>

                <Viewbox Grid.Column="1" 
                        Width="16" 
                        Height="16" 
                        VerticalAlignment="Center"
                        IsHitTestVisible="False">
                    <Viewbox.Style>
                        <Style TargetType="Viewbox">
                            <Setter Property="Margin" Value="0,0,10,0" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding EsCompacto, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                    <Setter Property="Margin" Value="0,0,5,0" />
                                    <Setter Property="Width" Value="14" />
                                    <Setter Property="Height" Value="14" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Viewbox.Style>
                    <Path Data="M12,2C6.47,2 2,6.47 2,12C2,17.53 6.47,22 12,22C17.53,22 22,17.53 22,12C22,6.47 17.53,2 12,2M12,20C7.59,20 4,16.41 4,12C4,11.46 4,10.93 4.13,10.42L8.27,14.56L8.27,16A2,2 0 0,0 10.27,18L10.27,19.31C10.82,19.75 11.41,20 12,20M19.07,17.22C18.31,15.9 17,15 15.5,15L13.5,15V12.5L14.5,11.5L14.5,9.5L16.5,7.5V11L18.5,13L20,13C20,13.5 19.96,14 19.88,14.53C19.67,15.54 19.39,16.45 19.07,17.22Z"
                          Fill="{DynamicResource SecondaryTextBrush}"/>
                </Viewbox>
            </Grid>
        </Border>
    </Grid>
</UserControl>
