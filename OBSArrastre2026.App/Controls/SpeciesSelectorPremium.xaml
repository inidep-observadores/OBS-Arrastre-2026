<UserControl x:Class="OBSArrastre2026.App.Controls.SpeciesSelectorPremium"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:OBSArrastre2026.App.Controls"
             xmlns:entities="clr-namespace:OBSArrastre2026.App.Data.Entities"
             mc:Ignorable="d" 
             d:DesignHeight="70" d:DesignWidth="300">
    <Grid>
        <StackPanel>
            <TextBlock x:Name="LabelText" 
                       Text="Especie" 
                       Style="{DynamicResource LabelStyle}" 
                       Margin="0,0,0,6" />
            
            <Grid>
                <ComboBox x:Name="SpeciesCombo"
                          Style="{DynamicResource PremiumComboBoxStyle}"
                          IsEditable="True"
                          IsTextSearchEnabled="False"
                          TextSearch.TextPath="FullDisplayName"
                          SelectedValuePath="ID">
                    <ComboBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type entities:Especie}">
                            <StackPanel Orientation="Horizontal" Margin="2,0">
                                <TextBlock Text="{Binding NombreVulgar}" 
                                           VerticalAlignment="Center"
                                           FontWeight="Medium" />
                                <TextBlock Text="{Binding NombreCientifico, StringFormat=' ({0})'}" 
                                           VerticalAlignment="Center"
                                           FontStyle="Italic"
                                           Opacity="0.7"
                                           Margin="6,0,0,0"
                                           FontSize="11" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                    
                    <ComboBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </ComboBox.ItemsPanel>
                </ComboBox>

                <TextBlock IsHitTestVisible="False"
                           Text="{Binding Watermark, RelativeSource={RelativeSource AncestorType=local:SpeciesSelectorPremium}}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left"
                           Margin="14,0,0,0"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           Opacity="0.5"
                           Visibility="Collapsed">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=SpeciesCombo}" Value="">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding SelectedItem, ElementName=SpeciesCombo}" Value="{x:Null}">
                                    <!-- Si no hay nada seleccionado, mostramos el watermark -->
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>
