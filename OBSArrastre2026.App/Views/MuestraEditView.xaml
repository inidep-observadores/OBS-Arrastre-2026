<UserControl x:Class="OBSArrastre2026.App.Views.MuestraEditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:OBSArrastre2026.App.ViewModels"
             xmlns:infra="clr-namespace:OBSArrastre2026.App.Infrastructure"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800">
    <AdornerDecorator>
        <Border Background="{DynamicResource ShellBackgroundBrush}"
                Padding="40"
                CornerRadius="0"
                MaxWidth="1000"
                MaxHeight="600"
                VerticalAlignment="Center"
                BorderBrush="{DynamicResource SidebarBorderBrush}"
                BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="60" Color="Black" Opacity="0.25" ShadowDepth="10" />
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Margin="0,0,0,30">
                    <TextBlock Text="MUESTRA BIOLÓGICA"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="{DynamicResource AccentBrush}" />
                    <TextBlock Text="Edición de Muestra"
                               FontSize="28"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               Margin="0,4,0,0" />
                </StackPanel>                <Grid Grid.Row="1">
                    <Grid.Resources>
                        <infra:BindingProxy x:Key="Proxy" Data="{Binding}" />
                    </Grid.Resources>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- CONTENIDO PRINCIPAL (IZQUIERDA) -->
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <Label Content="Especie" Style="{StaticResource FormLabelStyle}" />
                                    <ComboBox ItemsSource="{Binding FilteredEspecies}"
                                              SelectedItem="{Binding SelectedEspecie}"
                                              IsEditable="True"
                                              IsTextSearchEnabled="False"
                                              TextSearch.TextPath="NombreVulgar"
                                              Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                              Style="{StaticResource PremiumComboBoxStyle}"
                                              IsDropDownOpen="{Binding IsExpanded}"
                                              DropDownOpened="EspecieComboBox_DropDownOpened">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding NombreVulgar, StringFormat='{}{0} '}" FontWeight="Bold">
                                                    <Run Text="{Binding NombreCientifico, StringFormat='({0})'}" FontWeight="Normal" FontStyle="Italic" Foreground="{DynamicResource SecondaryTextBrush}" />
                                                </TextBlock>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <Label Content="Peso Muestra (gramos)" Style="{StaticResource FormLabelStyle}" />
                                    <TextBox Text="{Binding PesoMuestraGramos}" Style="{StaticResource PremiumTextBoxStyle}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <!-- SECCIÓN FRECUENCIAS -->
                        <Border Grid.Row="1" Margin="0,32,0,0" Style="{StaticResource SurfaceBorderStyle}" Padding="0" ClipToBounds="True">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Border Background="{DynamicResource SurfaceBackgroundBrush}" Padding="16,10" BorderBrush="{DynamicResource SidebarBorderBrush}" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <TextBlock Text="FRECUENCIAS DE TALLA" Style="{StaticResource SectionHeaderStyle}" VerticalAlignment="Center" FontSize="11" />
                                        <Button HorizontalAlignment="Right" 
                                                Command="{Binding AddFrecuenciaCommand}"
                                                Style="{StaticResource ThemeButtonStyle}"
                                                Foreground="{DynamicResource AccentBrush}"
                                                Padding="12,6">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="+ " FontWeight="Bold" />
                                                <TextBlock Text="AÑADIR TALLA" FontSize="10" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>

                                <DataGrid x:Name="FrecuenciasGrid"
                                          Grid.Row="1"
                                          ItemsSource="{Binding FrecuenciasTallas}" 
                                          SelectedItem="{Binding SelectedFrecuencia}"
                                          Style="{StaticResource PremiumDataGridStyle}"
                                          IsReadOnly="True"
                                          SelectionMode="Single"
                                          SelectionUnit="FullRow"
                                          BorderThickness="0">
                                    <DataGrid.InputBindings>
                                        <KeyBinding Key="Delete" 
                                                    Command="{Binding RemoveFrecuenciaCommand}" 
                                                    CommandParameter="{Binding SelectedItem, ElementName=FrecuenciasGrid}" />
                                    </DataGrid.InputBindings>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="TALLA" Binding="{Binding Talla}" Width="60" ElementStyle="{StaticResource DataGridTextLeft}" />
                                        
                                        <DataGridTextColumn Header="M. MAD." 
                                                            Binding="{Binding NroLangostinosMachoMaduros}" 
                                                            Width="65" 
                                                            ElementStyle="{StaticResource DataGridTextCenter}"
                                                            Visibility="{Binding Data.EsLangostino, Source={StaticResource Proxy}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        
                                        <DataGridTextColumn Header="MACHOS" Binding="{Binding NroMachos}" Width="65" ElementStyle="{StaticResource DataGridTextCenter}" />
                                        
                                        <DataGridTextColumn Header="HEMBRAS" Binding="{Binding NroHembras}" Width="65" ElementStyle="{StaticResource DataGridTextCenter}" />
                                        
                                        <DataGridTextColumn Header="H. MAD." 
                                                            Binding="{Binding NroLangostinosHembraMaduras}" 
                                                            Width="65" 
                                                            ElementStyle="{StaticResource DataGridTextCenter}"
                                                            Visibility="{Binding Data.EsLangostino, Source={StaticResource Proxy}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        
                                        <DataGridTextColumn Header="H. IMP." 
                                                            Binding="{Binding NroLangostinosHembraImpregnadas}" 
                                                            Width="65" 
                                                            ElementStyle="{StaticResource DataGridTextCenter}"
                                                            Visibility="{Binding Data.EsLangostino, Source={StaticResource Proxy}, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                        <DataGridTextColumn Header="INDET." Binding="{Binding NroIndeterminados}" Width="65" ElementStyle="{StaticResource DataGridTextCenter}" />
                                        
                                        <DataGridTextColumn Header="TOTAL" Binding="{Binding NroTotal, UpdateSourceTrigger=PropertyChanged}" Width="*" FontWeight="Bold" ElementStyle="{StaticResource DataGridTextRight}" />

                                        <DataGridTemplateColumn Width="40">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Command="{Binding DataContext.RemoveFrecuenciaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource ThemeButtonStyle}"
                                                            Foreground="{DynamicResource DangerForegroundBrush}"
                                                            Padding="0"
                                                            Content="✕" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- FORMULARIO LATERAL DE EDICIÓN (DERECHA - FULL HEIGHT) -->
                    <Border Grid.Column="1" 
                            Width="340"
                            Margin="20,0,0,0"
                            BorderBrush="{DynamicResource SidebarBorderBrush}" 
                            BorderThickness="1" 
                            CornerRadius="0"
                            Background="{DynamicResource CardBackgroundBrush}"
                            Visibility="{Binding SelectedFrecuencia, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=invert}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Background="{DynamicResource SurfaceBackgroundBrush}" Padding="16,10" BorderBrush="{DynamicResource SidebarBorderBrush}" BorderThickness="0,0,0,1">
                                <TextBlock Text="EDICIÓN DE FILA" Style="{StaticResource SectionHeaderStyle}" FontSize="11" />
                            </Border>

                            <ScrollViewer Grid.Row="1" Style="{StaticResource SlimScrollViewerStyle}" VerticalScrollBarVisibility="Auto" Padding="20">
                                <StackPanel DataContext="{Binding SelectedFrecuencia}" 
                                            PreviewKeyDown="LateralForm_PreviewKeyDown">
                                    
                                    <Label Content="Talla" Style="{StaticResource FormLabelStyle}" />
                                    <TextBox Text="{Binding Talla, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource PremiumTextBoxStyle}" Margin="0,0,0,12" x:Name="FirstField"/>

                                    <!-- Campos Langostino Macho -->
                                    <StackPanel Visibility="{Binding Data.EsLangostino, Source={StaticResource Proxy}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Label Content="Lang. Machos Maduros" Style="{StaticResource FormLabelStyle}" />
                                        <TextBox Text="{Binding NroLangostinosMachoMaduros, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource PremiumTextBoxStyle}" Margin="0,0,0,12" />
                                    </StackPanel>

                                    <Label Content="Nro. Machos" Style="{StaticResource FormLabelStyle}" />
                                    <TextBox Text="{Binding NroMachos, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource PremiumTextBoxStyle}" Margin="0,0,0,12" />

                                    <Label Content="Nro. Hembras" Style="{StaticResource FormLabelStyle}" />
                                    <TextBox Text="{Binding NroHembras, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource PremiumTextBoxStyle}" Margin="0,0,0,12" />

                                    <!-- Campos Langostino Hembra -->
                                    <StackPanel Visibility="{Binding Data.EsLangostino, Source={StaticResource Proxy}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Label Content="Lang. Hembras Maduras" Style="{StaticResource FormLabelStyle}" />
                                        <TextBox Text="{Binding NroLangostinosHembraMaduras, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource PremiumTextBoxStyle}" Margin="0,0,0,12" />

                                        <Label Content="Lang. Hembras Impregnadas" Style="{StaticResource FormLabelStyle}" />
                                        <TextBox Text="{Binding NroLangostinosHembraImpregnadas, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource PremiumTextBoxStyle}" Margin="0,0,0,12" />
                                    </StackPanel>

                                    <Label Content="Nro. Indeterminados" Style="{StaticResource FormLabelStyle}" />
                                    <TextBox Text="{Binding NroIndeterminados, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource PremiumTextBoxStyle}" Margin="0,0,0,12" />

                                    <Label Content="Nro. Total (Ejemplares)" Style="{StaticResource FormLabelStyle}" />
                                    <TextBox Text="{Binding NroTotal, UpdateSourceTrigger=PropertyChanged}" 
                                             Style="{StaticResource PremiumTextBoxStyle}" 
                                             FontWeight="Bold"
                                             Foreground="{DynamicResource AccentBrush}"
                                             Margin="0,0,0,20" />

                                    <Border Background="{DynamicResource SurfaceBackgroundBrush}" Padding="12" CornerRadius="4" Margin="0,0,0,24">
                                        <Grid>
                                            <TextBlock Text="TOTAL FILA" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Total}" HorizontalAlignment="Right" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                        </Grid>
                                    </Border>

                                    <!-- Navegación -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button Content="ANTERIOR" 
                                                Command="{Binding DataContext.GoToPreviousCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                Style="{StaticResource ThemeButtonStyle}"
                                                IsTabStop="False"
                                                FontSize="10" Height="36"/>
                                        <Button Grid.Column="2" 
                                                Content="SIGUIENTE" 
                                                Command="{Binding DataContext.GoToNextCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                FontSize="10" Height="36"
                                                IsDefault="True"/>
                                    </Grid>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>

                <Grid Grid.Row="2" Margin="0,30,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancelar"
                                Command="{Binding CancelCommand}"
                                Style="{StaticResource ThemeButtonStyle}"
                                Padding="24,10"
                                Margin="0,0,16,0" />
                        <Button Content="Guardar Muestra"
                                Command="{Binding SaveCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Padding="32,12" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </AdornerDecorator>
</UserControl>
