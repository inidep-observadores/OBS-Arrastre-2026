<UserControl x:Class="OBSArrastre2026.App.Views.ProcesosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:OBSArrastre2026.App.Views"
             xmlns:vm="clr-namespace:OBSArrastre2026.App.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1000"
             Background="{DynamicResource HeroBackgroundBrush}">
    
    <UserControl.Resources>
        <Style x:Key="ProcessCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="24" />
            <Setter Property="Margin" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource HoverBackgroundBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                    <Setter Property="RenderTransform">
                        <Setter.Value>
                            <TranslateTransform Y="-4" />
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="IconBorderStyle" TargetType="Border">
            <Setter Property="Width" Value="56" />
            <Setter Property="Height" Value="56" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Margin" Value="0,0,0,20" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="12,24">
                <!-- Sección: Gestión de Datos y Reportes -->
                <StackPanel Margin="0,0,0,40">
                    <StackPanel Orientation="Horizontal" Margin="12,0,0,16">
                        <TextBlock Text="⚙" FontSize="18" Foreground="{DynamicResource AccentBrush}" Margin="0,0,10,0" VerticalAlignment="Center" />
                        <TextBlock Text="Operaciones de Marea" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" />
                    </StackPanel>

                    <UniformGrid Columns="3">
                        <!-- Tarjeta: Generar Informe -->
                        <Border Style="{StaticResource ProcessCardStyle}">
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftClick" Command="{Binding GenerarInformeCommand}" />
                            </Border.InputBindings>
                            <StackPanel>
                                <Border Style="{StaticResource IconBorderStyle}" Background="#E3F2FD">
                                    <TextBlock Text="📦" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="Generar Informe" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,8" />
                                <TextBlock Text="Crea el paquete de cartografía, resúmenes en Excel y archivos auxiliares de la marea." 
                                           FontSize="14" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" LineHeight="20" />
                                
                                <Border Margin="0,24,0,0" Padding="0,12,0,0" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,1,0,0">
                                    <TextBlock Text="Lanzar proceso →" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" FontSize="13" />
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Tarjeta: Exportar DBF -->
                        <Border Style="{StaticResource ProcessCardStyle}">
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftClick" Command="{Binding ExportarDbfCommand}" />
                            </Border.InputBindings>
                            <StackPanel>
                                <Border Style="{StaticResource IconBorderStyle}" Background="#E8F5E9">
                                    <TextBlock Text="💾" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="Exportar DBF" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,8" />
                                <TextBlock Text="Genera los archivos legados en formato DBF compatibles con el sistema central del INIDEP." 
                                           FontSize="14" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" LineHeight="20" />
                                
                                <Border Margin="0,24,0,0" Padding="0,12,0,0" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,1,0,0">
                                    <TextBlock Text="Lanzar proceso →" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" FontSize="13" />
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Tarjeta: Cambiar Unidad de Descarte -->
                        <Border Style="{StaticResource ProcessCardStyle}">
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftClick" Command="{Binding CambiarUnidadDescarteCommand}" />
                            </Border.InputBindings>
                            <StackPanel>
                                <Border Style="{StaticResource IconBorderStyle}" Background="#FFF3E0">
                                    <TextBlock Text="⚙" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="Unidad de Descarte" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,8" />
                                <TextBlock Text="Configura masivamente si el descarte se expresa en kilos o porcentaje para toda la marea." 
                                           FontSize="14" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" LineHeight="20" />
                                
                                <Border Margin="0,24,0,0" Padding="0,12,0,0" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,1,0,0">
                                    <TextBlock Text="Configurar →" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" FontSize="13" />
                                </Border>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </StackPanel>
                
                <!-- Placeholder para futuras expansiones -->
                <Border Background="{DynamicResource CardBackgroundBrush}" 
                        BorderBrush="{DynamicResource CardBorderBrush}" 
                        BorderThickness="1" 
                        CornerRadius="12" 
                        Padding="32" 
                        Margin="12,0" 
                        Opacity="0.5">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Próximamente más procesos..." 
                                   FontSize="16" 
                                   FontStyle="Italic" 
                                   Foreground="{DynamicResource SecondaryTextBrush}" 
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="Estamos trabajando en nuevas herramientas de auditoría y exportación." 
                                   FontSize="13" 
                                   Foreground="{DynamicResource SecondaryTextBrush}" 
                                   Margin="0,8,0,0" 
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
