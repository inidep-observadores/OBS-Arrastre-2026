<UserControl x:Class="OBSArrastre2026.App.Views.ProduccionEditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:OBSArrastre2026.App.ViewModels"
             xmlns:controls="clr-namespace:OBSArrastre2026.App.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="650" d:DesignWidth="600">
    <AdornerDecorator>
        <Border Background="{DynamicResource ShellBackgroundBrush}"
                Padding="40"
                CornerRadius="0"
                MaxWidth="650"
                MaxHeight="750"
                VerticalAlignment="Center"
                BorderBrush="{DynamicResource SidebarBorderBrush}"
                BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="60" Color="Black" Opacity="0.25" ShadowDepth="10" />
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Margin="0,0,0,30">
                    <TextBlock Text="PRODUCCIÓN A BORDO"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="{DynamicResource AccentBrush}" />
                    <TextBlock Text="Registro de Producción"
                               FontSize="28"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               Margin="0,4,0,0" />
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,-10,0" Padding="0,0,10,0">
                    <StackPanel>
                        <!-- SECCIÓN GENERAL -->
                        <Grid Margin="0,0,0,24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <Label Content="Fecha" Style="{StaticResource FormLabelStyle}" />
                                <controls:DatePickerPremium SelectedDate="{Binding Fecha}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <Label Content="Etapa de Marea" Style="{StaticResource FormLabelStyle}" />
                                <ComboBox ItemsSource="{Binding Etapas}"
                                          SelectedItem="{Binding SelectedEtapa}"
                                          Style="{StaticResource PremiumComboBoxStyle}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Viaje " Foreground="{DynamicResource SecondaryTextBrush}" />
                                                <TextBlock Text="{Binding NumeroEtapa}" FontWeight="Bold" Margin="0,0,5,0" />
                                                <TextBlock Text=" (" Foreground="{DynamicResource SecondaryTextBrush}" />
                                                <TextBlock Text="{Binding FechaZarpada, StringFormat=dd/MM/yyyy}" />
                                                <TextBlock Text=" - " Foreground="{DynamicResource SecondaryTextBrush}" />
                                                <TextBlock Text="{Binding FechaArribo, StringFormat=dd/MM/yyyy, TargetNullValue='...'}" />
                                                <TextBlock Text=")" Foreground="{DynamicResource SecondaryTextBrush}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <controls:SpeciesSelectorPremium 
                            Label="Especie"
                            ItemsSource="{Binding AllEspecies}"
                            SelectedItem="{Binding SelectedEspecie}"
                            Margin="0,0,0,24" />

                        <StackPanel Margin="0,0,0,24">
                            <Label Content="Producto" Style="{StaticResource FormLabelStyle}" />
                            <ComboBox ItemsSource="{Binding Productos}"
                                      SelectedItem="{Binding SelectedProducto}"
                                      Text="{Binding ProductSearchText, UpdateSourceTrigger=PropertyChanged}"
                                      DisplayMemberPath="Codigo"
                                      IsEditable="True"
                                      TextSearch.TextPath="Codigo"
                                      Style="{StaticResource PremiumComboBoxStyle}" />
                        </StackPanel>

                        <Grid Margin="0,0,0,24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <Label Content="Categoría" Style="{StaticResource FormLabelStyle}" />
                                <TextBox Text="{Binding Categoria}" Style="{StaticResource PremiumTextBoxStyle}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <Label Content="Factor de Conversión" Style="{StaticResource FormLabelStyle}" />
                                <TextBox Text="{Binding Factor}" Style="{StaticResource PremiumTextBoxStyle}" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Margin="0,0,0,24">
                            <Label Content="Kilogramos" Style="{StaticResource FormLabelStyle}" />
                            <TextBox Text="{Binding Kg}" FontSize="24" FontWeight="Bold" Style="{StaticResource PremiumTextBoxStyle}" />
                        </StackPanel>

                        </StackPanel>
                </ScrollViewer>

                <controls:FormActionBar Grid.Row="2" 
                                        CancelCommand="{Binding CancelCommand}" 
                                        SaveCommand="{Binding SaveCommand}" 
                                        SaveContent="Guardar Registro" />
            </Grid>
        </Border>
    </AdornerDecorator>
</UserControl>
