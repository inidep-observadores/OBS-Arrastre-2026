<UserControl x:Class="OBSArrastre2026.App.Views.SubmuestraEditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:OBSArrastre2026.App.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800">
    <AdornerDecorator>
        <Border Background="{DynamicResource ShellBackgroundBrush}"
                Padding="40"
                CornerRadius="0"
                MaxWidth="900"
                MaxHeight="700"
                VerticalAlignment="Center"
                BorderBrush="{DynamicResource SidebarBorderBrush}"
                BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="60" Color="Black" Opacity="0.25" ShadowDepth="10" />
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Margin="0,0,0,30">
                    <TextBlock Text="DETALLE BIOLÓGICO POR INDIVIDUO"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="{DynamicResource AccentBrush}" />
                    <TextBlock Text="Edición de Submuestras"
                               FontSize="28"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               Margin="0,4,0,0" />
                </StackPanel>

                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    
                    <StackPanel Grid.Row="0">
                        <!-- CABECERA DE CONTEXTO (Muestra) -->
                        <Grid Margin="0,0,0,24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <Label Content="Especie" Style="{StaticResource FormLabelStyle}" />
                                <TextBox Text="{Binding EspecieNombre, Mode=OneWay}" 
                                         Style="{StaticResource PremiumTextBoxStyle}" 
                                         IsReadOnly="True" 
                                         Background="{DynamicResource SurfaceBackgroundBrush}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <Label Content="Peso Total Muestra" Style="{StaticResource FormLabelStyle}" />
                                <TextBox Text="{Binding PesoMuestraDisplay, Mode=OneWay}" 
                                         Style="{StaticResource PremiumTextBoxStyle}" 
                                         IsReadOnly="True"
                                         Background="{DynamicResource SurfaceBackgroundBrush}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                    
                    <!-- SECCIÓN SUBMUESTRAS -->
                    <Border Grid.Row="1" Style="{StaticResource SurfaceBorderStyle}" Padding="0" ClipToBounds="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Background="{DynamicResource SurfaceBackgroundBrush}" Padding="16,10" BorderBrush="{DynamicResource SidebarBorderBrush}" BorderThickness="0,0,0,1">
                                <Grid>
                                    <TextBlock Text="EJEMPLARES INDIVIDUALES" Style="{StaticResource SectionHeaderStyle}" VerticalAlignment="Center" FontSize="11" />
                                    <Button HorizontalAlignment="Right" 
                                            Command="{Binding AddItemCommand}"
                                            Style="{StaticResource ThemeButtonStyle}"
                                            Foreground="{DynamicResource AccentBrush}"
                                            Padding="12,6">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="+ " FontWeight="Bold" />
                                            <TextBlock Text="AÑADIR EJEMPLAR" FontSize="10" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>

                            <DataGrid x:Name="SubmuestrasGrid"
                                      Grid.Row="1" 
                                      ItemsSource="{Binding Submuestras}" 
                                      Style="{StaticResource PremiumDataGridStyle}">
                                <DataGrid.InputBindings>
                                    <KeyBinding Key="Delete" 
                                                Command="{Binding RemoveItemCommand}" 
                                                CommandParameter="{Binding SelectedItem, ElementName=SubmuestrasGrid}" />
                                </DataGrid.InputBindings>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="EJEMPLAR" Binding="{Binding NroEjemplar}" Width="80" ElementStyle="{StaticResource DataGridTextCenter}" />
                                    <DataGridTextColumn Header="SEXO" Binding="{Binding Sexo, UpdateSourceTrigger=PropertyChanged}" Width="60" ElementStyle="{StaticResource DataGridTextCenter}" />
                                    <DataGridTextColumn Header="ESTADIO" Binding="{Binding Estadio}" Width="80" ElementStyle="{StaticResource DataGridTextCenter}" />
                                    <DataGridTextColumn Header="LARGO (mm)" Binding="{Binding LargoMm}" Width="*" ElementStyle="{StaticResource DataGridTextCenter}" />
                                    <DataGridTextColumn Header="PESO (g)" Binding="{Binding PesoGramos}" Width="*" ElementStyle="{StaticResource DataGridTextCenter}" />
                                    
                                    <DataGridTemplateColumn Width="50">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Content="✕"
                                                        Style="{StaticResource ThemeButtonStyle}"
                                                        Foreground="{DynamicResource DangerForegroundBrush}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>

                <Grid Grid.Row="2" Margin="0,30,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancelar"
                                Command="{Binding CancelCommand}"
                                Style="{StaticResource ThemeButtonStyle}"
                                Padding="24,10"
                                Margin="0,0,16,0" />
                        <Button Content="Guardar Submuestras"
                                Command="{Binding SaveCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Padding="32,12" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </AdornerDecorator>
</UserControl>
