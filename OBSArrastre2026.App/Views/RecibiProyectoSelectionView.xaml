<UserControl x:Class="OBSArrastre2026.App.Views.RecibiProyectoSelectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:OBSArrastre2026.App.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="450">
    <Border Width="480" 
            Background="{DynamicResource CardBackgroundBrush}"
            BorderBrush="{DynamicResource CardBorderBrush}"
            BorderThickness="1"
            CornerRadius="0"
            VerticalAlignment="Center"
            HorizontalAlignment="Center">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="10" Opacity="0.15" Color="Black"/>
        </Border.Effect>
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Accent Bar -->
            <Border Grid.Row="0" Height="4" Background="{DynamicResource AccentBrush}" />

            <Border Grid.Row="1" Padding="32,24">
                <StackPanel>
                    <TextBlock Text="Selección de Especies" 
                               FontSize="22" FontWeight="Bold" 
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               Margin="0,0,0,8"/>
                    
                    <TextBlock Text="Marque las especies que realmente tienen otolitos. Solo las marcadas se incluirán en el reporte." 
                               FontSize="14" 
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Margin="0,0,0,20"
                               TextWrapping="Wrap"/>

                    <Border Background="{DynamicResource SurfaceBackgroundBrush}" 
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1"
                            Height="300">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Especies}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource SidebarBorderBrush}" 
                                                BorderThickness="0,0,0,1" 
                                                Padding="12,10">
                                            <CheckBox IsChecked="{Binding IsSelected}" 
                                                      VerticalContentAlignment="Center"
                                                      Padding="10,0,0,0">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding NombreCompleto}" 
                                                               FontSize="14" FontWeight="SemiBold" 
                                                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                    <TextBlock Text="{Binding DetalleLances, StringFormat='Lances: {0}'}" 
                                                               FontSize="12" 
                                                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                                                </StackPanel>
                                            </CheckBox>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Background="{DynamicResource SurfaceBackgroundBrush}" Padding="32,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    
                    <Button Content="Cancelar" 
                            Command="{Binding CancelarCommand}"
                            Style="{StaticResource ThemeButtonStyle}"
                            HorizontalAlignment="Stretch"
                            Margin="0,0,10,0" />

                    <Button Grid.Column="1"
                            Content="Generar Reporte" 
                            Command="{Binding ConfirmarCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            HorizontalAlignment="Stretch" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
