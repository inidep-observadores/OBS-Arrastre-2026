<Window x:Class="OBSArrastre2026.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:OBSArrastre2026.App.Views"
        xmlns:vm="clr-namespace:OBSArrastre2026.App.ViewModels"
        xmlns:controls="clr-namespace:OBSArrastre2026.App.Controls"
        xmlns:models="clr-namespace:OBSArrastre2026.App.Models"
        xmlns:gmap="clr-namespace:GMap.NET.WindowsPresentation;assembly=GMap.NET.WindowsPresentation"
        mc:Ignorable="d"
        Title="{Binding Title}"
        Width="1460"
        Height="920"
        MinWidth="1180"
        MinHeight="760"
        WindowStartupLocation="CenterScreen"
        Icon="assets/icons/app_icon.ico"
        WindowState="Maximized"
        Background="{DynamicResource ShellBackgroundBrush}"
        FontFamily="{DynamicResource TextFontFamily}">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:MareaEditViewModel}">
            <views:MareaEditView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:LanceEditViewModel}">
            <views:LanceEditView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:MuestraEditViewModel}">
            <views:MuestraEditView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:SubmuestraEditViewModel}">
            <views:SubmuestraEditView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ProduccionEditViewModel}">
            <views:ProduccionEditView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ReemplazoEspecieViewModel}">
            <views:ReemplazoEspecieView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ProcesosViewModel}">
            <views:ProcesosView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ConfiguracionViewModel}">
            <views:ConfiguracionView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:MareaListItemViewModel}">
            <!-- ... -->
            <Border Style="{StaticResource TableRowStyle}" Cursor="Hand">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftDoubleClick" 
                                  Command="{Binding DataContext.EditMareaCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                  CommandParameter="{Binding}"/>
                </Border.InputBindings>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.0*" />
                        <ColumnDefinition Width="1.8*" />
                        <ColumnDefinition Width="1.1*" />
                        <ColumnDefinition Width="1.8*" />
                        <ColumnDefinition Width="1.1*" />
                        <ColumnDefinition Width="1.1*" />
                        <ColumnDefinition Width="1.2*" />
                        <ColumnDefinition Width="0.5*" />
                        <ColumnDefinition Width="0.5*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Text="{Binding CodigoDisplay}" />
                    <TextBlock Grid.Column="1" Style="{StaticResource BodySecondaryStyle}" Text="{Binding BuqueNombre}" />
                    <TextBlock Grid.Column="2" Style="{StaticResource BodySecondaryStyle}" Text="{Binding FechaInicioDisplay}" />
                    <TextBlock Grid.Column="3" Style="{StaticResource BodySecondaryStyle}" Text="{Binding FechaFinDisplay}" />
                    <TextBlock Grid.Column="4" Style="{StaticResource BodySecondaryStyle}" Text="{Binding Comentarios}" />
                    <Border Grid.Column="5" Padding="10,4" HorizontalAlignment="Left" CornerRadius="0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource AccentMutedBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Estado}" Value="En curso">
                                        <Setter Property="Background" Value="{DynamicResource SuccessBackgroundBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock FontSize="11" FontWeight="SemiBold" Text="{Binding Estado}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Estado}" Value="En curso">
                                            <Setter Property="Foreground" Value="{DynamicResource SuccessForegroundBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                    
                    <StackPanel Grid.Column="6" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="8,0,0,0">
                        <!-- Botón para Establecer como Activa -->
                        <Button Command="{Binding SetActiveCommand}"
                                ToolTip="Establecer como marea activa">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ThemeButtonStyle}">
                                    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource WarningForegroundBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <TextBlock Text="★" FontSize="18" VerticalAlignment="Center" />
                        </Button>

                        <Button Command="{Binding GenerateSummaryCommand}"
                                ToolTip="Generar Resumen de Marea (PDF)"
                                Margin="8,0,0,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ThemeButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsValidating}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <TextBlock Text="📄" FontSize="16" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}"/>
                        </Button>

                        <Grid Margin="8,0,0,0">
                            <Button Command="{Binding ValidateCommand}"
                                    ToolTip="Validar datos y generar PDF">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource ThemeButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsValidating}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <TextBlock Text="✓" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}"/>
                            </Button>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsValidating}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <ProgressBar IsIndeterminate="True" Width="16" Height="16" Margin="0,0,5,0" />
                                <TextBlock Text="{Binding StatusText}" FontSize="10" FontStyle="Italic" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"/>
                            </StackPanel>
                        </Grid>

                        <Button Command="{Binding DataContext.DeleteRecordCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"
                                ToolTip="Eliminar marea y todos sus datos"
                                Style="{StaticResource ThemeButtonStyle}"
                                Margin="8,0,0,0">
                            <TextBlock Text="🗑" FontSize="16" Foreground="{DynamicResource DangerForegroundBrush}" VerticalAlignment="Center" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:LanceListItemViewModel}">
            <Border Style="{StaticResource TableRowStyle}" Cursor="Hand">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftDoubleClick" 
                                  Command="{Binding DataContext.EditLanceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                  CommandParameter="{Binding}"/>
                </Border.InputBindings>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.0*" />
                        <ColumnDefinition Width="1.8*" />
                        <ColumnDefinition Width="1.1*" />
                        <ColumnDefinition Width="1.8*" />
                        <ColumnDefinition Width="1.1*" />
                        <ColumnDefinition Width="1.1*" />
                        <ColumnDefinition Width="1.2*" />
                        <ColumnDefinition Width="0.5*" />
                        <ColumnDefinition Width="0.5*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Text="{Binding NroLance}" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="1" Style="{StaticResource BodySecondaryStyle}" Text="{Binding FechaDisplay}" HorizontalAlignment="Center" />
                    <TextBlock Grid.Column="2" Style="{StaticResource BodySecondaryStyle}" Text="{Binding LatitudDisplay}" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="3" Style="{StaticResource BodySecondaryStyle}" Text="{Binding LongitudDisplay}" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="4" Style="{StaticResource BodySecondaryStyle}" Text="{Binding CapturaTotal, StringFormat={}{0} kg}" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="5" Style="{StaticResource BodySecondaryStyle}" Text="{Binding HoraInicio}" HorizontalAlignment="Center" />
                    <TextBlock Grid.Column="6" Style="{StaticResource BodySecondaryStyle}" Text="{Binding HoraFin}" HorizontalAlignment="Center" />
                    
                    <Button Grid.Column="8"
                            Command="{Binding DataContext.DeleteRecordCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}"
                            ToolTip="Eliminar lance y sus muestras"
                            Style="{StaticResource ThemeButtonStyle}"
                            Margin="8,0,0,0">
                        <TextBlock Text="🗑" FontSize="16" Foreground="{DynamicResource DangerForegroundBrush}" VerticalAlignment="Center" />
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:MuestraListItemViewModel}">
            <Border Style="{StaticResource TableRowStyle}" Cursor="Hand">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftDoubleClick" 
                                  Command="{Binding DataContext.EditMuestraCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                  CommandParameter="{Binding}"/>
                </Border.InputBindings>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.0*" />
                        <ColumnDefinition Width="1.8*" />
                        <ColumnDefinition Width="1.1*" />
                        <ColumnDefinition Width="1.8*" />
                        <ColumnDefinition Width="1.1*" />
                        <ColumnDefinition Width="1.1*" />
                        <ColumnDefinition Width="1.2*" />
                        <ColumnDefinition Width="0.5*" />
                        <ColumnDefinition Width="0.5*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Text="{Binding LanceNro}" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="1" Style="{StaticResource BodySecondaryStyle}" Text="{Binding LanceFecha}" HorizontalAlignment="Center" />
                    <TextBlock Grid.Column="2" Style="{StaticResource BodySecondaryStyle}" Text="{Binding LanceHora}" HorizontalAlignment="Center" />
                    <TextBlock Grid.Column="3" Style="{StaticResource BodySecondaryStyle}" Text="{Binding EspecieDisplay}" HorizontalAlignment="Left" />
                    <TextBlock Grid.Column="4" Style="{StaticResource BodySecondaryStyle}" Text="{Binding PesoDisplay}" HorizontalAlignment="Right" />

                    <Button Grid.Column="8"
                            Command="{Binding DataContext.DeleteRecordCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}"
                            ToolTip="Eliminar muestra y submuestras"
                            Style="{StaticResource ThemeButtonStyle}"
                            Margin="8,0,0,0">
                        <TextBlock Text="🗑" FontSize="16" Foreground="{DynamicResource DangerForegroundBrush}" VerticalAlignment="Center" />
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ProduccionListItemViewModel}">
            <Border Style="{StaticResource TableRowStyle}" Cursor="Hand" Padding="18,8">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftDoubleClick" 
                                   Command="{Binding DataContext.OpenSelectedRecordEditCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                </Border.InputBindings>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.0*" />
                        <ColumnDefinition Width="1.8*" />
                        <ColumnDefinition Width="1.1*" />
                        <ColumnDefinition Width="1.8*" />
                        <ColumnDefinition Width="1.1*" />
                        <ColumnDefinition Width="1.1*" />
                        <ColumnDefinition Width="1.2*" />
                        <ColumnDefinition Width="0.5*" />
                        <ColumnDefinition Width="0.5*" />
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Text="{Binding FechaDisplay}" />
                    <TextBlock Grid.Column="1" Style="{StaticResource BodySecondaryStyle}" Text="{Binding EspecieDisplay}" />
                    <TextBlock Grid.Column="2" Style="{StaticResource BodySecondaryStyle}" Text="{Binding ProductoCodigo}" />
                    <TextBlock Grid.Column="3" Style="{StaticResource BodySecondaryStyle}" Text="{Binding Categoria}" />
                    <TextBlock Grid.Column="4" Style="{StaticResource BodySecondaryStyle}" HorizontalAlignment="Right" Text="{Binding Factor, StringFormat=\{0:F2\}}" />
                    <TextBlock Grid.Column="5" Style="{StaticResource BodySecondaryStyle}" HorizontalAlignment="Right" Text="{Binding Kg, StringFormat=\{0:F2\}}" />

                    <Button Grid.Column="8"
                            Command="{Binding DataContext.DeleteRecordCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}"
                            ToolTip="Eliminar registro de producción"
                            Style="{StaticResource ThemeButtonStyle}"
                            Margin="8,0,0,0">
                        <TextBlock Text="🗑" FontSize="16" Foreground="{DynamicResource DangerForegroundBrush}" VerticalAlignment="Center" />
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ControlProduccionListItemViewModel}">
            <Border Style="{StaticResource TableRowStyle}" Cursor="Hand">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftDoubleClick" 
                                  Command="{Binding DataContext.NavigateToControlProduccionDetailCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                  CommandParameter="{Binding}" />
                </Border.InputBindings>
                
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3.0*" />
                        <ColumnDefinition Width="1.4*" />
                        <ColumnDefinition Width="0.9*" />
                        <ColumnDefinition Width="1.4*" />
                        <ColumnDefinition Width="0.9*" />
                        <ColumnDefinition Width="0.9*" />
                        <ColumnDefinition Width="1.1*" />
                        <ColumnDefinition Width="0.4*" />
                        <ColumnDefinition Width="0.1*" />
                    </Grid.ColumnDefinitions>

                    <!-- Columna 1: Fecha (Detalle) o Especie (Resumen) -->
                    <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" TextTrimming="CharacterEllipsis">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="{Binding FechaDisplay}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSummaryView}" Value="True">
                                        <Setter Property="Text" Value="{Binding Especie}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Columna 2: Prod. Total -->
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" 
                               Foreground="{DynamicResource PrimaryTextBrush}" Text="{Binding ProduccionTotalDisplay}" />

                    <!-- Columna 3: Capt. Recon. -->
                    <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" 
                               Foreground="{DynamicResource SecondaryTextBrush}" Text="{Binding CapturaReconstruidaDisplay}" />

                    <!-- Columna 4: Captura -->
                    <TextBlock Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right" 
                               Foreground="{DynamicResource SecondaryTextBrush}" Text="{Binding CapturaBrutaDisplay}" />

                    <!-- Columna 5: Descarte -->
                    <TextBlock Grid.Column="4" VerticalAlignment="Center" HorizontalAlignment="Right" 
                               Foreground="{DynamicResource SecondaryTextBrush}" Text="{Binding DescarteKgDisplay}" />

                    <!-- Columna 6: Capt. Retenida -->
                    <TextBlock Grid.Column="5" VerticalAlignment="Center" HorizontalAlignment="Right" 
                               Foreground="{DynamicResource SecondaryTextBrush}" Text="{Binding CapturaRetenidaDisplay}" />

                    <!-- Columna 7: Dif. Kg -->
                    <TextBlock Grid.Column="6" VerticalAlignment="Center" HorizontalAlignment="Right" 
                               Foreground="{DynamicResource SecondaryTextBrush}" Text="{Binding DiferenciaKgDisplay}" />

                    <!-- Columna 8: Dif. % -->
                    <TextBlock Grid.Column="7" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="SemiBold">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="{Binding DiferenciaPorcentajeDisplay}" />
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasDiferenciaSignificativa}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    
                    <!-- Columna 9: Vacía/Padding -->
                    <TextBlock Grid.Column="8" Text="" />
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Margin="24"
                Padding="22"
                Background="{DynamicResource SidebarBackgroundBrush}"
                BorderBrush="{DynamicResource SidebarBorderBrush}"
                BorderThickness="1"
                CornerRadius="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Margin="0,18,0,0"
                               FontFamily="{DynamicResource DisplayFontFamily}"
                               FontSize="27"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               Text="Control de mareas" />
                </StackPanel>

                <ListBox Grid.Row="1"
                         Margin="0,26,0,24"
                         ItemsSource="{Binding NavigationItems}"
                         SelectedItem="{Binding SelectedNavigationItem}"
                         Background="Transparent"
                         BorderThickness="0"
                         ItemContainerStyle="{StaticResource SidebarItemStyle}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid x:Name="RootGrid" Background="Transparent" MinHeight="36">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Rectangle x:Name="SeparatorLine" 
                                           Grid.ColumnSpan="2" 
                                           Height="1" 
                                           Fill="{DynamicResource SidebarBorderBrush}" 
                                           Margin="0,12" 
                                           Visibility="Collapsed" />

                                <TextBlock x:Name="IconText"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontSize="14"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Text="{Binding Glyph}" />

                                <TextBlock x:Name="TitleText"
                                           Grid.Column="1"
                                           VerticalAlignment="Center"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           Text="{Binding Title}" />
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Section}" Value="{x:Static models:NavigationSection.Separator}">
                                    <Setter TargetName="IconText" Value="Collapsed" Property="Visibility" />
                                    <Setter TargetName="TitleText" Value="Collapsed" Property="Visibility" />
                                    <Setter TargetName="SeparatorLine" Value="Visible" Property="Visibility" />
                                    <Setter TargetName="RootGrid" Property="MinHeight" Value="25" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                    <Setter TargetName="RootGrid" Property="Opacity" Value="0.3" />
                                    <Setter TargetName="IconText" Property="Foreground" Value="Gray" />
                                    <Setter TargetName="TitleText" Property="Foreground" Value="Gray" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Row="2">
                    <Border Style="{StaticResource SurfaceBorderStyle}"
                            Margin="0,0,0,12"
                            Padding="16"
                            Background="{DynamicResource SidebarSecondaryBackgroundBrush}">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Text="MAREA ACTIVA"
                                       HorizontalAlignment="Center" />
                            
                            <Grid Margin="0,8,0,0" Visibility="{Binding ActiveMareaManager.ActiveMarea, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=invert}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock FontSize="16"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               HorizontalAlignment="Center"
                                               TextAlignment="Center">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0}/{1}">
                                                <Binding Path="ActiveMareaManager.ActiveMarea.NumeroInidep" />
                                                <Binding Path="ActiveMareaManager.ActiveMarea.AnioInidep" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                    <TextBlock Margin="0,4,0,0"
                                               FontSize="12"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               Text="{Binding ActiveMareaManager.ActiveMarea.Buque.Nombre}"
                                               HorizontalAlignment="Center"
                                               TextAlignment="Center" />
                                    
                                </StackPanel>
                            </Grid>

                            <TextBlock Margin="0,8,0,0"
                                       FontSize="13"
                                       FontStyle="Italic"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Text="Ninguna seleccionada"
                                       HorizontalAlignment="Center"
                                       Visibility="{Binding ActiveMareaManager.ActiveMarea, Converter={StaticResource NullToVisibilityConverter}}" />
                        </StackPanel>
                    </Border>
                    
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1"
              Margin="0,24,24,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Button Command="{Binding BackControlProduccionCommand}"
                            Visibility="{Binding IsControlProduccionDetailVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Style="{StaticResource ThemeButtonStyle}"
                            Width="44" Height="44"
                            Margin="0,0,16,0"
                            VerticalAlignment="Bottom"
                            ToolTip="Volver a lista de especies">
                        <TextBlock Text="←" FontSize="28" FontWeight="Bold" Margin="0,0,0,2" />
                    </Button>
                    <StackPanel>
                        <TextBlock FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBrush}"
                                   Text="{Binding PageEyebrow}" />
                    <TextBlock Margin="0,6,0,0"
                               FontFamily="{DynamicResource DisplayFontFamily}"
                               FontSize="36"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               Text="{Binding PageTitle}" />
                    <TextBlock Margin="0,8,0,0"
                               FontSize="14"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Text="{Binding PageDescription}" />
                </StackPanel>
                
                <Button Command="{Binding ExportControlProduccionPdfCommand}" 
                        Margin="32,0,0,0"
                        VerticalAlignment="Bottom"
                        Padding="16,10"
                        ToolTip="Generar reporte PDF del resumen de producción">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📄" Margin="0,0,8,0" VerticalAlignment="Center" FontSize="16"/>
                        <TextBlock Text="EXPORTAR RESUMEN" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    </StackPanel>
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedNavigationItem.Section}" Value="{x:Static models:NavigationSection.ControlProduccion}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsControlProduccionDetailVisible}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Top">
                    <Border Style="{StaticResource SurfaceBorderStyle}"
                            Margin="0,0,16,0"
                            Padding="16,10">
                        <Grid Width="260">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Margin="0,0,10,0"
                                       VerticalAlignment="Center"
                                       FontSize="16"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Text="⌕" />
                            <TextBlock Grid.Column="1"
                                       VerticalAlignment="Center"
                                       FontSize="13"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Text="{Binding SearchPlaceholder}" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SurfaceBorderStyle}"
                            Padding="6">
                        <StackPanel Orientation="Horizontal">
                            <Button Command="{Binding SetSystemThemeCommand}" Content="Sistema">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource ThemeButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSystemThemeActive}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource SelectionBackgroundBrush}" />
                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Command="{Binding SetLightThemeCommand}" Content="Claro">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource ThemeButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLightThemeActive}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource SelectionBackgroundBrush}" />
                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                            </DataTrigger>
