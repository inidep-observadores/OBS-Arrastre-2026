<Window x:Class="OBSArrastre2026.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:OBSArrastre2026.App.Views"
        xmlns:vm="clr-namespace:OBSArrastre2026.App.ViewModels"
        xmlns:controls="clr-namespace:OBSArrastre2026.App.Controls"
        mc:Ignorable="d"
        Title="{Binding Title}"
        Width="1460"
        Height="920"
        MinWidth="1180"
        MinHeight="760"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="{DynamicResource ShellBackgroundBrush}"
        FontFamily="{DynamicResource TextFontFamily}">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:MareaEditViewModel}">
            <views:MareaEditView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:MareaListItemViewModel}">
            <Border Style="{StaticResource TableRowStyle}" Cursor="Hand">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftDoubleClick" 
                                  Command="{Binding DataContext.EditMareaCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                  CommandParameter="{Binding}"/>
                </Border.InputBindings>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.2*" />
                        <ColumnDefinition Width="1.1*" />
                        <ColumnDefinition Width="1.1*" />
                        <ColumnDefinition Width="1.1*" />
                        <ColumnDefinition Width="1.2*" />
                        <ColumnDefinition Width="0.9*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               Text="{Binding CodigoDisplay}" />
                    <TextBlock Grid.Column="1"
                               Style="{StaticResource BodySecondaryStyle}"
                               Text="{Binding BuqueNombre}" />
                    <TextBlock Grid.Column="2"
                               Style="{StaticResource BodySecondaryStyle}"
                               Text="{Binding FechaInicioDisplay}" />
                    <TextBlock Grid.Column="3"
                               Style="{StaticResource BodySecondaryStyle}"
                               Text="{Binding FechaFinDisplay}" />
                    <TextBlock Grid.Column="4"
                               Style="{StaticResource BodySecondaryStyle}"
                               Text="{Binding Comentarios}" />
                    <Border Grid.Column="5"
                            Padding="10,4"
                            HorizontalAlignment="Left"
                            CornerRadius="0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource AccentMutedBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Estado}" Value="En curso">
                                        <Setter Property="Background" Value="{DynamicResource SuccessBackgroundBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Estado}" Value="Cerrada">
                                        <Setter Property="Background" Value="{DynamicResource AccentMutedBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock FontSize="11" FontWeight="SemiBold" Text="{Binding Estado}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Estado}" Value="En curso">
                                            <Setter Property="Foreground" Value="{DynamicResource SuccessForegroundBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Estado}" Value="Cerrada">
                                            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="294" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Margin="24"
                Padding="22"
                Background="{DynamicResource SidebarBackgroundBrush}"
                BorderBrush="{DynamicResource SidebarBorderBrush}"
                BorderThickness="1"
                CornerRadius="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <Border Width="58"
                            Height="58"
                            Background="{DynamicResource AccentBrush}"
                            CornerRadius="0"
                            HorizontalAlignment="Left">
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="23"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   Text="OA" />
                    </Border>
                    <TextBlock Margin="0,18,0,0"
                               FontFamily="{DynamicResource DisplayFontFamily}"
                               FontSize="27"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               Text="OBS Arrastre" />
                    <TextBlock Margin="0,6,0,0"
                               FontSize="13"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Text="Dashboard y modulos maestros en modo mockup" />
                </StackPanel>

                <ListBox Grid.Row="1"
                         Margin="0,26,0,24"
                         ItemsSource="{Binding NavigationItems}"
                         SelectedItem="{Binding SelectedNavigationItem}"
                         Background="Transparent"
                         BorderThickness="0"
                         ItemContainerStyle="{StaticResource SidebarItemStyle}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontSize="14"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Text="{Binding Glyph}" />

                                <TextBlock Grid.Column="1"
                                           VerticalAlignment="Center"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           Text="{Binding Title}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Border Grid.Row="2"
                        Style="{StaticResource SurfaceBorderStyle}"
                        Padding="16"
                        Background="{DynamicResource SidebarSecondaryBackgroundBrush}">
                    <StackPanel>
                        <TextBlock FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Text="ESTADO DEL SISTEMA" />
                        <TextBlock Margin="0,6,0,0"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   Text="Premium v2026" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1"
              Margin="0,24,24,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBrush}"
                               Text="{Binding PageEyebrow}" />
                    <TextBlock Margin="0,6,0,0"
                               FontFamily="{DynamicResource DisplayFontFamily}"
                               FontSize="36"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               Text="{Binding PageTitle}" />
                    <TextBlock Margin="0,8,0,0"
                               FontSize="14"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Text="{Binding PageDescription}" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Top">
                    <Border Style="{StaticResource SurfaceBorderStyle}"
                            Margin="0,0,16,0"
                            Padding="16,10">
                        <Grid Width="260">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Margin="0,0,10,0"
                                       VerticalAlignment="Center"
                                       FontSize="16"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Text="⌕" />
                            <TextBlock Grid.Column="1"
                                       VerticalAlignment="Center"
                                       FontSize="13"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Text="{Binding SearchPlaceholder}" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SurfaceBorderStyle}"
                            Padding="6">
                        <StackPanel Orientation="Horizontal">
                            <Button Command="{Binding SetSystemThemeCommand}" Content="Sistema">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource ThemeButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSystemThemeActive}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource SelectionBackgroundBrush}" />
                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Command="{Binding SetLightThemeCommand}" Content="Claro">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource ThemeButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLightThemeActive}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource SelectionBackgroundBrush}" />
                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Command="{Binding SetDarkThemeCommand}" Content="Oscuro">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource ThemeButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDarkThemeActive}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource SelectionBackgroundBrush}" />
                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1"
                    Padding="28"
                    Background="{DynamicResource HeroBackgroundBrush}"
                    CornerRadius="0">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" Direction="270"
                                      ShadowDepth="2" BlurRadius="20" Opacity="0.07" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock FontSize="17"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       Text="Vista de Operaciones" />
                            <TextBlock Margin="0,5,0,0"
                                       FontSize="13"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Text="Gestión y monitoreo en tiempo real." />
                        </StackPanel>

                        <Button Grid.Column="1"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding PrimaryActionCommand}"
                                Content="{Binding PrimaryActionLabel}" />
                    </Grid>

                    <Grid Grid.Row="1">
                        <Grid Visibility="{Binding IsDashboardVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <ItemsControl ItemsSource="{Binding DashboardCards}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="4" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource MetricCardStyle}">
                                            <StackPanel>
                                                <TextBlock FontSize="12"
                                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                                           Text="{Binding Label}" />
                                                <TextBlock Margin="0,10,0,0"
                                                           FontFamily="{DynamicResource DisplayFontFamily}"
                                                           FontSize="30"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                                           Text="{Binding Value}" />
                                                <TextBlock Margin="0,8,0,0"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource AccentBrush}"
                                                           Text="{Binding Delta}" />
                                                <TextBlock Margin="0,10,0,0"
                                                           FontSize="12"
                                                           TextWrapping="Wrap"
                                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                                           Text="{Binding Footnote}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.35*" />
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Style="{StaticResource SurfaceBorderStyle}"
                                        Padding="20">
                                    <StackPanel>
                                        <TextBlock FontSize="18"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                                   Text="Ritmo operativo semanal" />
                                        <ItemsControl Margin="0,20,0,0"
                                                      ItemsSource="{Binding TrendPoints}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,0,0,14">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="56" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="88" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock VerticalAlignment="Center"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                                                   Text="{Binding Label}" />
                                                        <ProgressBar Grid.Column="1"
                                                                     Style="{StaticResource SlimProgressBarStyle}"
                                                                     Margin="14,0"
                                                                     Maximum="100"
                                                                     Value="{Binding Value}" />
                                                        <TextBlock Grid.Column="2"
                                                                   VerticalAlignment="Center"
                                                                   HorizontalAlignment="Right"
                                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                                   Text="{Binding Caption}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <ItemsControl Grid.Column="2"
                                              ItemsSource="{Binding InsightCards}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource SurfaceBorderStyle}"
                                                    Margin="0,0,0,14"
                                                    Padding="16">
                                                <StackPanel>
                                                    <TextBlock FontSize="11"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource AccentBrush}"
                                                               Text="{Binding Label}" />
                                                    <TextBlock Margin="0,8,0,0"
                                                               FontSize="16"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                                               Text="{Binding Title}" />
                                                    <TextBlock Margin="0,8,0,0"
                                                               FontSize="13"
                                                               TextWrapping="Wrap"
                                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                                               Text="{Binding Description}" />
                                                    <TextBlock Margin="0,12,0,0"
                                                               FontSize="12"
                                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                                               Text="{Binding Meta}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Grid>

                        <Grid Visibility="{Binding IsTableVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <ItemsControl ItemsSource="{Binding ActiveFilters}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource FilterChipStyle}">
                                            <TextBlock FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AccentBrush}"
                                                       Text="{Binding}" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Barra de Filtros Mareas -->
                            <Border Grid.Row="1" 
                                    Style="{StaticResource SurfaceBorderStyle}"
                                    Padding="16,12"
                                    Margin="0,0,0,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Orientation="Horizontal">
                                        <StackPanel Margin="0,0,16,0">
                                            <Label Content="Año" Style="{StaticResource FormLabelStyle}"/>
                                            <ComboBox Width="90" 
                                                      Style="{StaticResource PremiumComboBoxStyle}"
                                                      ItemsSource="{Binding Anios}"
                                                      SelectedItem="{Binding MareasFilterAnio}"/>
                                        </StackPanel>

                                        <StackPanel Margin="0,0,16,0">
                                            <Label Content="Buque" Style="{StaticResource FormLabelStyle}"/>
                                            <ComboBox Width="180" 
                                                      Style="{StaticResource PremiumComboBoxStyle}"
                                                      ItemsSource="{Binding Buques}"
                                                      SelectedItem="{Binding MareasFilterBuque}"
                                                      DisplayMemberPath="Nombre"/>
                                        </StackPanel>

                                        <StackPanel Margin="0,0,16,0">
                                            <Label Content="Rango de Fechas" Style="{StaticResource FormLabelStyle}"/>
                                            <StackPanel Orientation="Horizontal">
                                                <controls:DatePickerPremium Width="130" SelectedDate="{Binding MareasFilterFechaDesde}"/>
                                                <TextBlock Text=" - " VerticalAlignment="Center" Margin="4,18,4,0"/>
                                                <controls:DatePickerPremium Width="130" SelectedDate="{Binding MareasFilterFechaHasta}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Column="3" Margin="8,0,16,0">
                                        <Label Content="Búsqueda" Style="{StaticResource FormLabelStyle}"/>
                                        <TextBox Style="{StaticResource PremiumTextBoxStyle}"
                                                 Text="{Binding MareasSearchText, UpdateSourceTrigger=PropertyChanged}"
                                                 Tag="Número o comentarios..."/>
                                    </StackPanel>

                                    <Button Grid.Column="4" 
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Command="{Binding ApplyMareaFiltersCommand}"
                                            Content="Filtrar"
                                            VerticalAlignment="Bottom"
                                            Padding="24,10"/>
                                </Grid>
                            </Border>

                            <Border Grid.Row="2"
                                    Margin="0,6,0,4"
                                    Padding="18,10"
                                    BorderBrush="{DynamicResource TableRowBorderBrush}"
                                    BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.2*" />
                                        <ColumnDefinition Width="1.1*" />
                                        <ColumnDefinition Width="1.1*" />
                                        <ColumnDefinition Width="1.1*" />
                                        <ColumnDefinition Width="1.2*" />
                                        <ColumnDefinition Width="0.9*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource HeaderLabelStyle}" Text="{Binding Column1Header}" />
                                    <TextBlock Grid.Column="1" Style="{StaticResource HeaderLabelStyle}" Text="{Binding Column2Header}" />
                                    <TextBlock Grid.Column="2" Style="{StaticResource HeaderLabelStyle}" Text="{Binding Column3Header}" />
                                    <TextBlock Grid.Column="3" Style="{StaticResource HeaderLabelStyle}" Text="{Binding Column4Header}" />
                                    <TextBlock Grid.Column="4" Style="{StaticResource HeaderLabelStyle}" Text="{Binding Column5Header}" />
                                    <TextBlock Grid.Column="5" Style="{StaticResource HeaderLabelStyle}" Text="Estado" />
                                </Grid>
                            </Border>

                            <ScrollViewer Grid.Row="3"
                                          Style="{StaticResource SlimScrollViewerStyle}"
                                          VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Records}">
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Overlay for Editing -->
        <Grid Grid.ColumnSpan="2">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding CurrentEditViewModel}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Border Background="Black" Opacity="0.5" />
            <ContentControl Content="{Binding CurrentEditViewModel}" />
        </Grid>
    </Grid>
</Window>
