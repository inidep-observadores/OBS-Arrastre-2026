<Window x:Class="OBSArrastre2026.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:OBSArrastre2026.App.Views"
        xmlns:vm="clr-namespace:OBSArrastre2026.App.ViewModels"
        xmlns:controls="clr-namespace:OBSArrastre2026.App.Controls"
        xmlns:models="clr-namespace:OBSArrastre2026.App.Models"
        xmlns:gmap="clr-namespace:GMap.NET.WindowsPresentation;assembly=GMap.NET.WindowsPresentation"
        mc:Ignorable="d"
        Title="{Binding Title}"
        Width="1460"
        Height="920"
        MinWidth="1180"
        MinHeight="760"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="{DynamicResource ShellBackgroundBrush}"
        FontFamily="{DynamicResource TextFontFamily}">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:MareaEditViewModel}">
            <views:MareaEditView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:LanceEditViewModel}">
            <views:LanceEditView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:MareaListItemViewModel}">
            <!-- ... contenido existente mapeado a Marea ... -->
            <Border Style="{StaticResource TableRowStyle}" Cursor="Hand">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftDoubleClick" 
                                  Command="{Binding DataContext.EditMareaCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                  CommandParameter="{Binding}"/>
                </Border.InputBindings>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.2*" />
                        <ColumnDefinition Width="1.1*" />
                        <ColumnDefinition Width="1.1*" />
                        <ColumnDefinition Width="1.1*" />
                        <ColumnDefinition Width="1.2*" />
                        <ColumnDefinition Width="0.9*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Text="{Binding CodigoDisplay}" />
                    <TextBlock Grid.Column="1" Style="{StaticResource BodySecondaryStyle}" Text="{Binding BuqueNombre}" />
                    <TextBlock Grid.Column="2" Style="{StaticResource BodySecondaryStyle}" Text="{Binding FechaInicioDisplay}" />
                    <TextBlock Grid.Column="3" Style="{StaticResource BodySecondaryStyle}" Text="{Binding FechaFinDisplay}" />
                    <TextBlock Grid.Column="4" Style="{StaticResource BodySecondaryStyle}" Text="{Binding Comentarios}" />
                    <Border Grid.Column="5" Padding="10,4" HorizontalAlignment="Left" CornerRadius="0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource AccentMutedBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Estado}" Value="En curso">
                                        <Setter Property="Background" Value="{DynamicResource SuccessBackgroundBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock FontSize="11" FontWeight="SemiBold" Text="{Binding Estado}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Estado}" Value="En curso">
                                            <Setter Property="Foreground" Value="{DynamicResource SuccessForegroundBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                    
                    <!-- Botón para Establecer como Activa -->
                    <Button Grid.Column="6" 
                            Command="{Binding SetActiveCommand}"
                            ToolTip="Establecer como marea activa"
                            Margin="8,0,0,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ThemeButtonStyle}">
                                <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource WarningForegroundBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="★" FontSize="18" VerticalAlignment="Center" />
                    </Button>
                    
                    <Grid Grid.Column="7" Margin="8,0,0,0">
                        <!-- Botón normal -->
                        <Button Command="{Binding ValidateCommand}"
                                ToolTip="Validar datos y generar PDF">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ThemeButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsValidating}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <TextBlock Text="📋" FontSize="16" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}"/>
                        </Button>

                        <!-- Indicador de progreso -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsValidating}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <ProgressBar IsIndeterminate="True" Width="16" Height="16" Margin="0,0,5,0" />
                            <TextBlock Text="{Binding StatusText}" FontSize="10" FontStyle="Italic" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:LanceListItemViewModel}">
            <Border Style="{StaticResource TableRowStyle}" Cursor="Hand">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftDoubleClick" 
                                  Command="{Binding DataContext.EditLanceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                  CommandParameter="{Binding}"/>
                </Border.InputBindings>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.2*" />
                        <ColumnDefinition Width="1.1*" />
                        <ColumnDefinition Width="1.1*" />
                        <ColumnDefinition Width="1.1*" />
                        <ColumnDefinition Width="1.2*" />
                        <ColumnDefinition Width="0.9*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Text="{Binding NroLance}" />
                    <TextBlock Grid.Column="1" Style="{StaticResource BodySecondaryStyle}" Text="{Binding FechaDisplay}" />
                    <TextBlock Grid.Column="2" Style="{StaticResource BodySecondaryStyle}" Text="{Binding LatitudDisplay}" />
                    <TextBlock Grid.Column="3" Style="{StaticResource BodySecondaryStyle}" Text="{Binding LongitudDisplay}" />
                    <TextBlock Grid.Column="4" Style="{StaticResource BodySecondaryStyle}" Text="{Binding CapturaTotal, StringFormat={}{0} kg}" />
                    <TextBlock Grid.Column="5" Style="{StaticResource BodySecondaryStyle}" Text="{Binding HoraInicio}" />
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="294" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Margin="24"
                Padding="22"
                Background="{DynamicResource SidebarBackgroundBrush}"
                BorderBrush="{DynamicResource SidebarBorderBrush}"
                BorderThickness="1"
                CornerRadius="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <Border Width="58"
                            Height="58"
                            Background="{DynamicResource AccentBrush}"
                            CornerRadius="0"
                            HorizontalAlignment="Left">
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="23"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   Text="OA" />
                    </Border>
                    <TextBlock Margin="0,18,0,0"
                               FontFamily="{DynamicResource DisplayFontFamily}"
                               FontSize="27"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               Text="OBS Arrastre" />
                    <TextBlock Margin="0,6,0,0"
                               FontSize="13"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Text="Dashboard y modulos maestros en modo mockup" />
                </StackPanel>

                <ListBox Grid.Row="1"
                         Margin="0,26,0,24"
                         ItemsSource="{Binding NavigationItems}"
                         SelectedItem="{Binding SelectedNavigationItem}"
                         Background="Transparent"
                         BorderThickness="0"
                         ItemContainerStyle="{StaticResource SidebarItemStyle}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid x:Name="RootGrid" Background="Transparent">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="IconText"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontSize="14"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Text="{Binding Glyph}" />

                                <TextBlock x:Name="TitleText"
                                           Grid.Column="1"
                                           VerticalAlignment="Center"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           Text="{Binding Title}" />
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                    <Setter TargetName="RootGrid" Property="Opacity" Value="0.3" />
                                    <Setter TargetName="IconText" Property="Foreground" Value="Gray" />
                                    <Setter TargetName="TitleText" Property="Foreground" Value="Gray" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Row="2">
                    <Border Style="{StaticResource SurfaceBorderStyle}"
                            Margin="0,0,0,12"
                            Padding="16"
                            Background="{DynamicResource SidebarSecondaryBackgroundBrush}">
                        <StackPanel>
                            <TextBlock FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Text="MAREA ACTIVA" />
                            
                            <Grid Margin="0,8,0,0" Visibility="{Binding ActiveMareaManager.ActiveMarea, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=invert}">
                                <StackPanel>
                                    <TextBlock FontSize="16"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource PrimaryTextBrush}">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0}/{1}">
                                                <Binding Path="ActiveMareaManager.ActiveMarea.NumeroInidep" />
                                                <Binding Path="ActiveMareaManager.ActiveMarea.AnioInidep" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                    <TextBlock Margin="0,4,0,0"
                                               FontSize="12"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               Text="{Binding ActiveMareaManager.ActiveMarea.Buque.Nombre}" />
                                    
                                </StackPanel>
                            </Grid>

                            <TextBlock Margin="0,8,0,0"
                                       FontSize="13"
                                       FontStyle="Italic"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Text="Ninguna seleccionada"
                                       Visibility="{Binding ActiveMareaManager.ActiveMarea, Converter={StaticResource NullToVisibilityConverter}}" />
                        </StackPanel>
                    </Border>
                    
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1"
              Margin="0,24,24,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBrush}"
                               Text="{Binding PageEyebrow}" />
                    <TextBlock Margin="0,6,0,0"
                               FontFamily="{DynamicResource DisplayFontFamily}"
                               FontSize="36"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               Text="{Binding PageTitle}" />
                    <TextBlock Margin="0,8,0,0"
                               FontSize="14"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Text="{Binding PageDescription}" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Top">
                    <Border Style="{StaticResource SurfaceBorderStyle}"
                            Margin="0,0,16,0"
                            Padding="16,10">
                        <Grid Width="260">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Margin="0,0,10,0"
                                       VerticalAlignment="Center"
                                       FontSize="16"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Text="⌕" />
                            <TextBlock Grid.Column="1"
                                       VerticalAlignment="Center"
                                       FontSize="13"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Text="{Binding SearchPlaceholder}" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SurfaceBorderStyle}"
                            Padding="6">
                        <StackPanel Orientation="Horizontal">
                            <Button Command="{Binding SetSystemThemeCommand}" Content="Sistema">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource ThemeButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSystemThemeActive}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource SelectionBackgroundBrush}" />
                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Command="{Binding SetLightThemeCommand}" Content="Claro">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource ThemeButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLightThemeActive}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource SelectionBackgroundBrush}" />
                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Command="{Binding SetDarkThemeCommand}" Content="Oscuro">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource ThemeButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDarkThemeActive}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource SelectionBackgroundBrush}" />
                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1"
                    Padding="28"
                    Background="{DynamicResource HeroBackgroundBrush}"
                    CornerRadius="0">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" Direction="270"
                                      ShadowDepth="2" BlurRadius="20" Opacity="0.07" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock FontSize="17"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       Text="Vista de Operaciones" />
                            <TextBlock Margin="0,5,0,0"
                                       FontSize="13"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Text="Gestión y monitoreo en tiempo real." />
                        </StackPanel>

                        <Button Grid.Column="1"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding PrimaryActionCommand}"
                                Content="{Binding PrimaryActionLabel}" />
                    </Grid>

                    <Grid Grid.Row="1">
                        <Grid Visibility="{Binding IsDashboardVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <ItemsControl ItemsSource="{Binding DashboardCards}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="4" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource MetricCardStyle}">
                                            <StackPanel>
                                                <TextBlock FontSize="12"
                                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                                           Text="{Binding Label}" />
                                                <TextBlock Margin="0,10,0,0"
                                                           FontFamily="{DynamicResource DisplayFontFamily}"
                                                           FontSize="30"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                                           Text="{Binding Value}" />
                                                <TextBlock Margin="0,8,0,0"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource AccentBrush}"
                                                           Text="{Binding Delta}" />
                                                <TextBlock Margin="0,10,0,0"
                                                           FontSize="12"
                                                           TextWrapping="Wrap"
                                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                                           Text="{Binding Footnote}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.35*" />
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Style="{StaticResource SurfaceBorderStyle}"
                                        Padding="20">
                                    <StackPanel>
                                        <TextBlock FontSize="18"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                                   Text="Ritmo operativo semanal" />
                                        <ItemsControl Margin="0,20,0,0"
                                                      ItemsSource="{Binding TrendPoints}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,0,0,14">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="56" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="88" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock VerticalAlignment="Center"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                                                   Text="{Binding Label}" />
                                                        <ProgressBar Grid.Column="1"
                                                                     Style="{StaticResource SlimProgressBarStyle}"
                                                                     Margin="14,0"
                                                                     Maximum="100"
                                                                     Value="{Binding Value}" />
                                                        <TextBlock Grid.Column="2"
                                                                   VerticalAlignment="Center"
                                                                   HorizontalAlignment="Right"
                                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                                   Text="{Binding Caption}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <ItemsControl Grid.Column="2"
                                              ItemsSource="{Binding InsightCards}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource SurfaceBorderStyle}"
                                                    Margin="0,0,0,14"
                                                    Padding="16">
                                                <StackPanel>
                                                    <TextBlock FontSize="11"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource AccentBrush}"
                                                               Text="{Binding Label}" />
                                                    <TextBlock Margin="0,8,0,0"
                                                               FontSize="16"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                                               Text="{Binding Title}" />
                                                    <TextBlock Margin="0,8,0,0"
                                                               FontSize="13"
                                                               TextWrapping="Wrap"
                                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                                               Text="{Binding Description}" />
                                                    <TextBlock Margin="0,12,0,0"
                                                               FontSize="12"
                                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                                               Text="{Binding Meta}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Grid>

                        <Grid Visibility="{Binding IsTableVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition>
                                    <ColumnDefinition.Style>
                                        <Style TargetType="ColumnDefinition">
                                            <Setter Property="Width" Value="0" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedNavigationItem.Section}" Value="{x:Static models:NavigationSection.Lances}">
                                                    <Setter Property="Width" Value="1.4*" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ColumnDefinition.Style>
                                </ColumnDefinition>
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                            <ItemsControl ItemsSource="{Binding ActiveFilters}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource FilterChipStyle}">
                                            <TextBlock FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AccentBrush}"
                                                       Text="{Binding}" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Barra de Filtros Mareas -->
                            <Border Grid.Row="1" 
                                    Padding="16,12"
                                    Margin="0,0,0,16">
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource SurfaceBorderStyle}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedNavigationItem.Section}" Value="{x:Static models:NavigationSection.Mareas}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Orientation="Horizontal">
                                        <StackPanel Margin="0,0,16,0">
                                            <Label Content="Año" Style="{StaticResource FormLabelStyle}"/>
                                            <ComboBox Width="90" 
                                                      Style="{StaticResource PremiumComboBoxStyle}"
                                                      ItemsSource="{Binding Anios}"
                                                      SelectedItem="{Binding MareasFilterAnio}">
                                                <ComboBox.InputBindings>
                                                    <KeyBinding Key="Enter" Command="{Binding ApplyMareaFiltersCommand}" />
                                                </ComboBox.InputBindings>
                                            </ComboBox>
                                        </StackPanel>

                                        <StackPanel Margin="0,0,16,0">
                                            <Label Content="Buque" Style="{StaticResource FormLabelStyle}"/>
                                            <ComboBox Width="180" 
                                                      Style="{StaticResource PremiumComboBoxStyle}"
                                                      ItemsSource="{Binding Buques}"
                                                      SelectedItem="{Binding MareasFilterBuque}"
                                                      DisplayMemberPath="Nombre">
                                                <ComboBox.InputBindings>
                                                    <KeyBinding Key="Enter" Command="{Binding ApplyMareaFiltersCommand}" />
                                                </ComboBox.InputBindings>
                                            </ComboBox>
                                        </StackPanel>

                                        <StackPanel Margin="0,0,16,0">
                                            <Label Content="Rango de Fechas" Style="{StaticResource FormLabelStyle}"/>
                                            <StackPanel Orientation="Horizontal">
                                                <controls:DatePickerPremium Width="150" SelectedDate="{Binding MareasFilterFechaDesde}">
                                                    <controls:DatePickerPremium.InputBindings>
                                                        <KeyBinding Key="Enter" Command="{Binding ApplyMareaFiltersCommand}" />
                                                    </controls:DatePickerPremium.InputBindings>
                                                </controls:DatePickerPremium>
                                                <TextBlock Text=" - " VerticalAlignment="Center" Margin="4,18,4,0"/>
                                                <controls:DatePickerPremium Width="150" SelectedDate="{Binding MareasFilterFechaHasta}">
                                                    <controls:DatePickerPremium.InputBindings>
                                                        <KeyBinding Key="Enter" Command="{Binding ApplyMareaFiltersCommand}" />
                                                    </controls:DatePickerPremium.InputBindings>
                                                </controls:DatePickerPremium>
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Column="3" Margin="8,0,16,0">
                                        <Label Content="Búsqueda" Style="{StaticResource FormLabelStyle}"/>
                                        <TextBox Style="{StaticResource PremiumTextBoxStyle}"
                                                 Text="{Binding MareasSearchText}"
                                                 Tag="Número o comentarios...">
                                            <TextBox.InputBindings>
                                                <KeyBinding Key="Enter" Command="{Binding ApplyMareaFiltersCommand}" />
                                            </TextBox.InputBindings>
                                        </TextBox>
                                    </StackPanel>

                                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Bottom">
                                        <Button Style="{StaticResource ThemeButtonStyle}"
                                                Command="{Binding ClearMareaFiltersCommand}"
                                                Content="Limpiar"
                                                Margin="0,0,12,0"
                                                Padding="16,10"/>
                                        <Button Style="{StaticResource PrimaryButtonStyle}"
                                                Command="{Binding ApplyMareaFiltersCommand}"
                                                Content="Filtrar"
                                                Padding="24,10"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Barra de Filtros Lances -->
                            <Border Grid.Row="1" 
                                    Padding="16,12"
                                    Margin="0,0,0,16">
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource SurfaceBorderStyle}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedNavigationItem.Section}" Value="{x:Static models:NavigationSection.Lances}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Orientation="Horizontal">
                                        <StackPanel Margin="0,0,16,0">
                                            <Label Content="Rango de Fechas" Style="{StaticResource FormLabelStyle}"/>
                                            <StackPanel Orientation="Horizontal">
                                                <controls:DatePickerPremium Width="150" SelectedDate="{Binding LancesFilterFechaDesde}">
                                                    <controls:DatePickerPremium.InputBindings>
                                                        <KeyBinding Key="Enter" Command="{Binding ApplyLanceFiltersCommand}" />
                                                    </controls:DatePickerPremium.InputBindings>
                                                </controls:DatePickerPremium>
                                                <TextBlock Text=" - " VerticalAlignment="Center" Margin="4,18,4,0"/>
                                                <controls:DatePickerPremium Width="150" SelectedDate="{Binding LancesFilterFechaHasta}">
                                                    <controls:DatePickerPremium.InputBindings>
                                                        <KeyBinding Key="Enter" Command="{Binding ApplyLanceFiltersCommand}" />
                                                    </controls:DatePickerPremium.InputBindings>
                                                </controls:DatePickerPremium>
                                            </StackPanel>
                                        </StackPanel>

                                        <StackPanel Margin="0,0,16,0">
                                            <Label Content="Nro. Lance" Style="{StaticResource FormLabelStyle}"/>
                                            <TextBox Width="100" 
                                                     Style="{StaticResource PremiumTextBoxStyle}"
                                                     Text="{Binding LancesFilterNroLance, TargetNullValue=''}">
                                                <TextBox.InputBindings>
                                                    <KeyBinding Key="Enter" Command="{Binding ApplyLanceFiltersCommand}" />
                                                </TextBox.InputBindings>
                                            </TextBox>
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Margin="8,0,16,0">
                                        <Label Content="Especie" Style="{StaticResource FormLabelStyle}"/>
                                        <TextBox Style="{StaticResource PremiumTextBoxStyle}"
                                                 Text="{Binding LancesFilterEspecie}"
                                                 Tag="Buscar especie...">
                                            <TextBox.InputBindings>
                                                <KeyBinding Key="Enter" Command="{Binding ApplyLanceFiltersCommand}" />
                                            </TextBox.InputBindings>
                                        </TextBox>
                                    </StackPanel>

                                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Bottom">
                                        <Button Style="{StaticResource ThemeButtonStyle}"
                                                Command="{Binding ClearLanceFiltersCommand}"
                                                Content="Limpiar"
                                                Margin="0,0,12,0"
                                                Padding="16,10"/>
                                        <Button Style="{StaticResource PrimaryButtonStyle}"
                                                Command="{Binding ApplyLanceFiltersCommand}"
                                                Content="Filtrar"
                                                Padding="24,10"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Grid.Row="2"
                                    Margin="0,6,0,4"
                                    Padding="18,10"
                                    BorderBrush="{DynamicResource TableRowBorderBrush}"
                                    BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.2*" />
                                        <ColumnDefinition Width="1.1*" />
                                        <ColumnDefinition Width="1.1*" />
                                        <ColumnDefinition Width="1.1*" />
                                        <ColumnDefinition Width="1.1*" />
                                        <ColumnDefinition Width="1.2*" />
                                        <ColumnDefinition Width="0.9*" />
                                        <ColumnDefinition Width="40" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource HeaderLabelStyle}" Text="{Binding Column1Header}" />
                                    <TextBlock Grid.Column="1" Style="{StaticResource HeaderLabelStyle}" Text="{Binding Column2Header}" />
                                    <TextBlock Grid.Column="2" Style="{StaticResource HeaderLabelStyle}" Text="{Binding Column3Header}" />
                                    <TextBlock Grid.Column="3" Style="{StaticResource HeaderLabelStyle}" Text="{Binding Column4Header}" />
                                    <TextBlock Grid.Column="4" Style="{StaticResource HeaderLabelStyle}" Text="{Binding Column5Header}" />
                                    <TextBlock Grid.Column="5" Style="{StaticResource HeaderLabelStyle}" Text="Estado" />
                                </Grid>
                            </Border>

                            <ListBox Grid.Row="3"
                                     ItemsSource="{Binding Records}"
                                     SelectedItem="{Binding SelectedRecord}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     HorizontalContentAlignment="Stretch"
                                     VirtualizingStackPanel.IsVirtualizing="True"
                                     VirtualizingStackPanel.VirtualizationMode="Recycling">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <ContentPresenter />
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                        </Grid>

                        <GridSplitter Grid.Column="1" 
                                      Width="6" 
                                      HorizontalAlignment="Center" 
                                      VerticalAlignment="Stretch"
                                      Background="{DynamicResource SidebarBorderBrush}"
                                      ShowsPreview="True">
                            <GridSplitter.Style>
                                <Style TargetType="GridSplitter">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedNavigationItem.Section}" Value="{x:Static models:NavigationSection.Lances}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </GridSplitter.Style>
                        </GridSplitter>

                        <Border Grid.Column="2" 
                                Margin="12,0,0,0" 
                                BorderBrush="{DynamicResource TableRowBorderBrush}" 
                                BorderThickness="1"
                                ClipToBounds="True">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedNavigationItem.Section}" Value="{x:Static models:NavigationSection.Lances}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <gmap:GMapControl x:Name="MainMap" 
                                              MaxZoom="18"
                                              MinZoom="2"
                                              Zoom="10"
                                              Loaded="MainMap_Loaded" />
                        </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Overlay for Editing -->
        <Grid Grid.ColumnSpan="2">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding CurrentEditViewModel}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Border Background="Black" Opacity="0.5" />
            <ContentControl Content="{Binding CurrentEditViewModel}" />
        </Grid>

        <!-- Overlay for Universal Dialogs (Premium MessageBox) -->
        <Grid Grid.ColumnSpan="2">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ActiveDialog}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Border Background="Black" Opacity="0.4" />
            <ContentControl Content="{Binding ActiveDialog}" />
        </Grid>
    </Grid>
</Window>
