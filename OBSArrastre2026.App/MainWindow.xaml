                                        <DataTrigger Binding="{Binding SelectedNavigationItem.Section}" Value="{x:Static models:NavigationSection.Lances}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SelectedNavigationItem.Section}" Value="{x:Static models:NavigationSection.ControlProduccion}">
                                            <Setter Property="Visibility" Value="{Binding IsControlProduccionDetailVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </GridSplitter.Style>
                        </GridSplitter>

                        <Border Grid.Column="2" 
                                Margin="12,0,0,0" 
                                BorderBrush="{DynamicResource TableRowBorderBrush}" 
                                BorderThickness="1"
                                ClipToBounds="True">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedNavigationItem.Section}" Value="{x:Static models:NavigationSection.Lances}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid>
                                    <gmap:GMapControl x:Name="MainMap" 
                                                      MaxZoom="18"
                                                      MinZoom="2"
                                                      Zoom="10"
                                                      Loaded="MainMap_Loaded"
                                                      MouseMove="MainMap_MouseMove"
                                                      MouseLeave="MainMap_MouseLeave" />

                                    <!-- HUD de Datos de Navegación -->
                                    <Border HorizontalAlignment="Right" VerticalAlignment="Top" 
                                            Margin="16" Padding="14" 
                                            Background="{DynamicResource CardBackgroundBrush}" 
                                            Opacity="0.9"
                                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                            CornerRadius="8"
                                            Visibility="{Binding CurrentPlaybackPoint, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=invert}">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="15" ShadowDepth="0" Opacity="0.15" />
                                        </Border.Effect>
                                        <StackPanel Width="170">
                                            <TextBlock Text="NAV DATA HUD" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,12" />
                                            
                                            <Grid Margin="0,0,0,6">
                                                <TextBlock Text="FECHA" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding CurrentPlaybackPoint.FechaHora, StringFormat=dd/MM/yyyy}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" HorizontalAlignment="Right" />
                                            </Grid>
                                            <Grid Margin="0,0,0,6">
                                                <TextBlock Text="HORA" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding CurrentPlaybackPoint.FechaHora, StringFormat=HH:mm:ss}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" HorizontalAlignment="Right" />
                                            </Grid>
                                            <Separator Background="{DynamicResource CardBorderBrush}" Margin="0,4,0,8" />
                                            
                                            <Grid Margin="0,0,0,6">
                                                <TextBlock Text="LATITUD" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding CurrentPlaybackPoint.Latitud, Converter={StaticResource CoordinateConverter}, ConverterParameter=lat}" 
                                                           FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" HorizontalAlignment="Right" />
                                            </Grid>
                                            <Grid Margin="0,0,0,6">
                                                <TextBlock Text="LONGITUD" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding CurrentPlaybackPoint.Longitud, Converter={StaticResource CoordinateConverter}, ConverterParameter=lon}" 
                                                           FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" HorizontalAlignment="Right" />
                                            </Grid>
                                            <Separator Background="{DynamicResource CardBorderBrush}" Margin="0,4,0,8" />

                                            <Grid Margin="0,0,0,6">
                                                <TextBlock Text="VELOCIDAD" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding CurrentPlaybackPoint.Velocidad, StringFormat=\{0:0.0\} nudos}" 
                                                           FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" HorizontalAlignment="Right" />
                                            </Grid>
                                            <Grid>
                                                <TextBlock Text="RUMBO" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding CurrentPlaybackPoint.Rumbo, StringFormat=\{0:0\}º}" 
                                                           FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" HorizontalAlignment="Right" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- HUD de Coordenadas del Puntero -->
                                    <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" 
                                            Margin="16" Padding="10,6" 
                                            Background="{DynamicResource CardBackgroundBrush}" 
                                            Opacity="0.85"
                                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                            CornerRadius="6"
                                            IsHitTestVisible="False">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="10" ShadowDepth="0" Opacity="0.1" />
                                        </Border.Effect>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="POSICIÓN:" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Text="{Binding MouseLatitudeDisplay}" 
                                                       FontSize="11" 
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource PrimaryTextBrush}" 
                                                       VerticalAlignment="Center" />
                                            <TextBlock Text="   " FontSize="11" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding MouseLongitudeDisplay}" 
                                                       FontSize="11" 
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource PrimaryTextBrush}" 
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Control de Capas de Mapa -->
                                    <Border HorizontalAlignment="Left" VerticalAlignment="Top" 
                                            Margin="16" Padding="14" 
                                            Background="{DynamicResource CardBackgroundBrush}" 
                                            Opacity="0.9"
                                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                            CornerRadius="8"
                                            Visibility="{Binding TotalTrackPoints, Converter={StaticResource IntToVisibilityConverter}}">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="15" ShadowDepth="0" Opacity="0.15" />
                                        </Border.Effect>
                                        <StackPanel>
                                            <TextBlock Text="CAPAS DE TRAYECTORIA" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,12" />
                                            
                                            <CheckBox Content="Mostrar Línea de Track" 
                                                      IsChecked="{Binding ShowTrackLine, UpdateSourceTrigger=PropertyChanged}" 
                                                      Foreground="{DynamicResource PrimaryTextBrush}"
                                                      FontSize="11" Margin="0,0,0,8" 
                                                      Cursor="Hand" />
                                            
                                            <CheckBox Content="Mostrar Puntos de Track" 
                                                      IsChecked="{Binding ShowTrackPoints, UpdateSourceTrigger=PropertyChanged}" 
                                                      Foreground="{DynamicResource PrimaryTextBrush}"
                                                      FontSize="11" 
                                                      Cursor="Hand" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Panel de Reproducción de Trayectoria -->
                                <Border Grid.Row="1" 
                                        Background="{DynamicResource SidebarSecondaryBackgroundBrush}"
                                        BorderBrush="{DynamicResource SidebarBorderBrush}"
                                        BorderThickness="0,1,0,0"
                                        Padding="16,12">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding TotalTrackPoints, Converter={StaticResource IntToVisibilityConverter}}" Value="Visible">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="180" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Controles -->
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <controls:DatePickerPremium SelectedDate="{Binding SelectedPlaybackDate}" 
                                                                        Width="110" 
                                                                        Height="32" 
                                                                        Margin="0,0,12,0" 
                                                                        EsCompacto="True" />
                                            
                                            <Button Command="{Binding GoToStartCommand}" 
                                                    Style="{StaticResource ThemeButtonStyle}"
                                                    ToolTip="Ir al Inicio"
                                                    Padding="6">
                                                <TextBlock Text="⏮" FontSize="14" />
                                            </Button>
                                            <Button Command="{Binding PrevPointCommand}" 
                                                    Style="{StaticResource ThemeButtonStyle}"
                                                    ToolTip="Punto Anterior"
                                                    Padding="6">
                                                <TextBlock Text="⏪" FontSize="14" />
                                            </Button>
                                            
                                            <Grid Margin="4,0">
                                                <!-- Botón Play (cuando no está reproduciendo) -->
                                                <Button Command="{Binding PlayCommand}" 
                                                        Style="{StaticResource PrimaryButtonStyle}"
                                                        ToolTip="Reproducir"
                                                        Padding="8,4"
                                                        Visibility="{Binding IsPlaying, Converter={StaticResource EnhancedBooleanToVisibilityConverter}, ConverterParameter=invert}">
                                                    <TextBlock Text="▶" FontSize="14" Foreground="White" />
                                                </Button>
                                                <!-- Botón Stop (cuando está reproduciendo) -->
                                                <Button Command="{Binding PauseCommand}" 
                                                        Style="{StaticResource PrimaryButtonStyle}"
                                                        ToolTip="Detener"
                                                        Padding="8,4"
                                                        Background="{DynamicResource DangerForegroundBrush}"
                                                        Visibility="{Binding IsPlaying, Converter={StaticResource EnhancedBooleanToVisibilityConverter}}">
                                                    <TextBlock Text="⏹" FontSize="14" Foreground="White" />
                                                </Button>
                                            </Grid>

                                            <Button Command="{Binding NextPointCommand}" 
                                                    Style="{StaticResource ThemeButtonStyle}"
                                                    ToolTip="Siguiente Punto"
                                                    Padding="6">
                                                <TextBlock Text="⏩" FontSize="14" />
                                            </Button>
                                            <Button Command="{Binding GoToEndCommand}" 
                                                    Style="{StaticResource ThemeButtonStyle}"
                                                    ToolTip="Ir al Final"
                                                    Padding="6">
                                                <TextBlock Text="⏭" FontSize="14" />
                                            </Button>
                                        </StackPanel>

                                        <!-- Deslizador -->
                                        <Grid Grid.Column="1" Margin="24,0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Slider Minimum="0" 
                                                    Maximum="{Binding TotalTrackPoints, Mode=OneWay, Converter={StaticResource MathConverter}, ConverterParameter=x-1}"
                                                    Value="{Binding CurrentTrackPointIndex}"
                                                    Style="{StaticResource PremiumSliderStyle}"
                                                    VerticalAlignment="Center">
                                                <Slider.ToolTip>
                                                    <ToolTip Content="{Binding SelectedTrackPointInfo}" 
                                                             Visibility="{Binding SelectedTrackPointInfo, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=invert}"/>
                                                </Slider.ToolTip>
                                            </Slider>
                                            <TextBlock Grid.Row="1" 
                                                       Text="{Binding SelectedTrackPointInfo}" 
                                                       HorizontalAlignment="Center" 
                                                       FontSize="11" 
                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                       Margin="0,4,0,0" />
                                        </Grid>

                                        <!-- Ventana de Visibilidad -->
                                        <Grid Grid.Column="2" Margin="16,0,24,0" 
                                              IsEnabled="{Binding IsTrackVisibilitySliderEnabled}"
                                              VerticalAlignment="Center">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <TextBlock Text="VENTANA:" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding TrackVisibilityWindowDaysLabel}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="4,0"/>
                                            </StackPanel>
                                            <Slider Grid.Row="1" 
                                                    Minimum="0" Maximum="6" 
                                                    Value="{Binding TrackVisibilitySliderValue}" 
                                                    TickFrequency="1" IsSnapToTickEnabled="True"
                                                    Style="{StaticResource PremiumSliderStyle}"
                                                    Margin="0,2,0,0"/>
                                        </Grid>

                                        <!-- Info Adicional -->
                                        <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right">
                                            <TextBlock Text="REPRODUCCIÓN DE TRAYECTORIA" 
                                                       FontSize="10" 
                                                       FontWeight="Bold" 
                                                       Foreground="{DynamicResource AccentBrush}" 
                                                       HorizontalAlignment="Right"/>
                                            <TextBlock FontSize="12" 
                                                       Foreground="{DynamicResource SecondaryTextBrush}" 
                                                       HorizontalAlignment="Right"
                                                       Margin="0,2,0,0">
                                                <Run Text="{Binding CurrentTrackPointIndex, Mode=OneWay, Converter={StaticResource MathConverter}, ConverterParameter=x+1, TargetNullValue=0}" />
                                                <Run Text=" / " />
                                                <Run Text="{Binding TotalTrackPoints, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Detail Sidebar (Specific to ControlProduccion) -->
                        <Grid Grid.Column="2" Width="380">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedNavigationItem.Section}" Value="{x:Static models:NavigationSection.ControlProduccion}">
                                            <Setter Property="Visibility" Value="{Binding IsControlProduccionDetailVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>

                            <Border BorderBrush="{DynamicResource TableRowBorderBrush}" 
                                    BorderThickness="1"
                                    ClipToBounds="True"
                                    Background="{DynamicResource SidebarBackgroundBrush}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Border Padding="16" Background="{DynamicResource SidebarSecondaryBackgroundBrush}" BorderBrush="{DynamicResource SidebarBorderBrush}" BorderThickness="0,0,0,1">
                                        <StackPanel>
                                            <TextBlock Text="DETALLE POR LANCE" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,8"/>
                                            <TextBlock Text="{Binding SelectedControlItem.Especie}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                            <TextBlock Text="{Binding SelectedControlItem.FechaDisplay}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                        </StackPanel>
                                    </Border>

                                    <ListView Grid.Row="1" 
                                              ItemsSource="{Binding ControlLanceDetails}"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              SelectionMode="Single">
                                        <ListView.ItemContainerStyle>
                                            <Style TargetType="ListViewItem">
                                                 <Setter Property="Background" Value="Transparent" />
                                                 <Setter Property="BorderThickness" Value="0" />
                                                 <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                 <EventSetter Event="MouseDoubleClick" Handler="ControlLance_MouseDoubleClick" />
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListViewItem">
                                                            <Border x:Name="Bd" 
                                                                    Background="{TemplateBinding Background}" 
                                                                    BorderBrush="{TemplateBinding BorderBrush}" 
                                                                    BorderThickness="{TemplateBinding BorderThickness}" 
                                                                    Padding="0" 
                                                                    SnapsToDevicePixels="True">
                                                                <GridViewRowPresenter VerticalAlignment="{TemplateBinding VerticalContentAlignment}" 
                                                                                      SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBackgroundBrush}" />
                                                                </Trigger>
                                                                <Trigger Property="IsSelected" Value="True">
                                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectionBackgroundBrush}" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ListView.ItemContainerStyle>
                                        <ListView.View>
                                            <GridView>
                                                <GridView.ColumnHeaderContainerStyle>
                                                    <Style TargetType="GridViewColumnHeader">
                                                        <Setter Property="Padding" Value="10,8" />
                                                        <Setter Property="HorizontalContentAlignment" Value="Right" />
                                                        <Setter Property="Background" Value="Transparent" />
                                                        <Setter Property="BorderThickness" Value="0,0,0,1" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource TableRowBorderBrush}" />
                                                        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
                                                        <Setter Property="FontSize" Value="11" />
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="GridViewColumnHeader">
                                                                    <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}">
                                                                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                                                                    </Border>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </GridView.ColumnHeaderContainerStyle>
                                                <GridViewColumn Header="LANCE" Width="85">
                                                     <GridViewColumn.CellTemplate>
                                                         <DataTemplate>
                                                             <TextBlock Text="{Binding NroLanceDisplay}" 
                                                                        FontWeight="SemiBold" 
                                                                        Foreground="{DynamicResource PrimaryTextBrush}" 
                                                                        Margin="10,4"
                                                                        ToolTip="{Binding EspecieDetalle}"/>
                                                         </DataTemplate>
                                                     </GridViewColumn.CellTemplate>
                                                 </GridViewColumn>
                                                <GridViewColumn Width="85">
                                                    <GridViewColumn.Header>
                                                        <TextBlock Text="CAPTURA" />
                                                    </GridViewColumn.Header>
                                                    <GridViewColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding CapturaKgDisplay}" Foreground="{DynamicResource PrimaryTextBrush}" HorizontalAlignment="Right" Margin="0,4,10,4"/>
                                                        </DataTemplate>
                                                    </GridViewColumn.CellTemplate>
                                                </GridViewColumn>
                                                <GridViewColumn Width="85">
                                                    <GridViewColumn.Header>
                                                        <TextBlock Text="DESCARTE" />
                                                    </GridViewColumn.Header>
                                                    <GridViewColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding DescarteKgDisplay}" Foreground="{DynamicResource DangerForegroundBrush}" HorizontalAlignment="Right" Margin="0,4,10,4"/>
                                                        </DataTemplate>
                                                    </GridViewColumn.CellTemplate>
                                                </GridViewColumn>
                                                <GridViewColumn Width="85">
                                                    <GridViewColumn.Header>
                                                        <TextBlock Text="RETENIDA" />
                                                    </GridViewColumn.Header>
                                                    <GridViewColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding NetaKgDisplay}" Foreground="{DynamicResource SuccessForegroundBrush}" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,4,10,4"/>
                                                        </DataTemplate>
                                                    </GridViewColumn.CellTemplate>
                                                </GridViewColumn>
                                            </GridView>
                                        </ListView.View>
                                    </ListView>

                                    <Border Grid.Row="2" 
                                            Background="{DynamicResource SidebarSecondaryBackgroundBrush}" 
                                            BorderBrush="{DynamicResource SidebarBorderBrush}" 
                                            BorderThickness="0,1,0,0"
                                            Padding="12,14">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="85" />
                                                <ColumnDefinition Width="85" />
                                                <ColumnDefinition Width="85" />
                                                <ColumnDefinition Width="85" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="TOTAL" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding TotalCapturaKg, StringFormat={}{0:N1}}" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0"/>
                                            <TextBlock Grid.Column="2" Text="{Binding TotalDescarteKg, StringFormat={}{0:N1}}" FontWeight="Bold" Foreground="{DynamicResource DangerForegroundBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0"/>
                                            <TextBlock Grid.Column="3" Text="{Binding TotalRetenidaKg, StringFormat={}{0:N1}}" FontWeight="Bold" Foreground="{DynamicResource SuccessForegroundBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0"/>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Overlay for Editing -->
        <Grid Grid.ColumnSpan="2">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding CurrentEditViewModel}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Border Background="Black" Opacity="0.5" />
            <ContentControl Content="{Binding CurrentEditViewModel}" />
        </Grid>

        <!-- Overlay for Universal Dialogs (Premium MessageBox) -->
        <Grid Grid.ColumnSpan="2">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ActiveDialog}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Border Background="Black" Opacity="0.4" />
            <ContentControl Content="{Binding ActiveDialog}" />
        </Grid>
    </Grid>
</Window>
