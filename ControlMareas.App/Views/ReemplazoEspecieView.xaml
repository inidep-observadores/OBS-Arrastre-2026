<UserControl x:Class="ControlMareas.App.Views.ReemplazoEspecieView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ControlMareas.App.Views"
             xmlns:vm="clr-namespace:ControlMareas.App.ViewModels"
             xmlns:controls="clr-namespace:ControlMareas.App.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             Background="{DynamicResource SurfaceBackgroundBrush}">
    
    <Grid Margin="24" Background="{DynamicResource SurfaceBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="Reemplazo de Especie" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="28" Margin="0,0,0,8"/>
            <TextBlock Text="Seleccione la especie de reemplazo para cada entrada mal identificada. Los cambios se aplicarán a toda la marea activa." 
                       Style="{StaticResource SubtitleStyle}" Opacity="0.7"/>
        </StackPanel>

        <!-- Table Header -->
        <Border Grid.Row="1" VerticalAlignment="Top" Background="{DynamicResource SurfaceBackgroundBrush}" 
                CornerRadius="8,8,0,0" BorderBrush="{DynamicResource TableRowBorderBrush}" BorderThickness="1,1,1,0" Panel.ZIndex="1"
                Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="3*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="ESPECIE ORIGINAL" Style="{StaticResource HeaderLabelStyle}" />
                <TextBlock Grid.Column="1" Text="RECUENTO" Style="{StaticResource HeaderLabelStyle}" HorizontalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="ESPECIE DE REEMPLAZO" Style="{StaticResource HeaderLabelStyle}" Margin="10,0,0,0"/>
            </Grid>
        </Border>

        <!-- List -->
        <Border Grid.Row="1" Margin="0,44,0,0" Background="{DynamicResource CardBackgroundBrush}" 
                CornerRadius="0,0,8,8" BorderBrush="{DynamicResource TableRowBorderBrush}" BorderThickness="1">
            <ListBox ItemsSource="{Binding EspeciesEnMarea}" 
                     Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     HorizontalContentAlignment="Stretch">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border BorderBrush="{DynamicResource TableRowBorderBrush}" BorderThickness="0,0,0,1" Background="{TemplateBinding Background}">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource HoverBackgroundBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="16,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="3*" />
                                </Grid.ColumnDefinitions>
                                
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding EspecieOriginal.NombreVulgar}" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                    <TextBlock Text="{Binding EspecieOriginal.NombreCientifico}" FontStyle="Italic" Opacity="0.6" FontSize="11" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                </StackPanel>
    
                                <Border Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" 
                                        Background="{DynamicResource SurfaceBackgroundBrush}" CornerRadius="12" Padding="8,2">
                                    <TextBlock Text="{Binding Ocurrencias}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                </Border>
    
                                <controls:SpeciesSelectorPremium Grid.Column="2" 
                                                                ItemsSource="{Binding DataContext.TodasLasEspecies, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                SelectedItem="{Binding EspecieNueva}"
                                                                Label="" Watermark="Seleccionar reemplazo..."
                                                                Margin="10,0,0,0"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <controls:FormActionBar Grid.Row="2" 
                                CancelCommand="{Binding CancelCommand}" 
                                SaveCommand="{Binding SaveCommand}" 
                                SaveContent="Aplicar Cambios Masivos" />

        <!-- Loading Overlay -->
        <Grid Grid.RowSpan="3" Background="#80000000" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="200" Height="4" Foreground="{DynamicResource AccentBrush}"/>
                <TextBlock Text="Procesando reemplazos..." Foreground="White" Margin="0,12,0,0" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
