<UserControl x:Class="ControlMareas.App.Views.RevisorDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ControlMareas.App.Views"
             xmlns:vm="clr-namespace:ControlMareas.App.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="450"
             d:DataContext="{d:DesignInstance Type=vm:RevisorDialogViewModel}"
             FocusManager.FocusedElement="{Binding ElementName=txtNombre}">
             
    <Border Width="450" 
            Background="{DynamicResource CardBackgroundBrush}"
            BorderBrush="{DynamicResource CardBorderBrush}"
            BorderThickness="1"
            CornerRadius="0"
            VerticalAlignment="Center"
            HorizontalAlignment="Center">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="10" Opacity="0.15" Color="Black"/>
        </Border.Effect>
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header/Accent Bar -->
            <Border Grid.Row="0" Height="4" Background="{DynamicResource AccentBrush}" />

            <Border Grid.Row="1" Padding="40,32,40,24">
                <StackPanel>
                    <TextBlock Text="Datos del Revisor" 
                               HorizontalAlignment="Center"
                               FontSize="20" FontWeight="Bold" 
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               Margin="0,0,0,12"
                               TextAlignment="Center"/>

                    <TextBlock Text="Por favor, ingrese el nombre y apellido del revisor. Estos datos son obligatorios para continuar." 
                               HorizontalAlignment="Center"
                               FontSize="14" 
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0,0,0,24"/>

                    <Label Content="Nombre" Style="{StaticResource FormLabelStyle}" />
                    <TextBox x:Name="txtNombre"
                             Text="{Binding Nombre, UpdateSourceTrigger=PropertyChanged}" 
                             Style="{StaticResource PremiumTextBoxStyle}" 
                             Margin="0,0,0,16" />

                    <Label Content="Apellido" Style="{StaticResource FormLabelStyle}" />
                    <TextBox Text="{Binding Apellido, UpdateSourceTrigger=PropertyChanged}" 
                             Style="{StaticResource PremiumTextBoxStyle}" />

                </StackPanel>
            </Border>

            <Border Grid.Row="2" Background="{DynamicResource SurfaceBackgroundBrush}" Padding="32,20">
                <StackPanel>
                    <TextBlock Text="{Binding ErrorMessage}" 
                               Foreground="{DynamicResource DangerForegroundBrush}" 
                               HorizontalAlignment="Center" 
                               Margin="0,0,0,10" 
                               FontWeight="SemiBold"
                               Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}" />
                    
                    <Button Content="Aceptar" 
                            Command="{Binding AcceptCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            IsDefault="True"
                            HorizontalAlignment="Stretch" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
