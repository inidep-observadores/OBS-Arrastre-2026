<UserControl x:Class="ControlMareas.App.Views.LanceEditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ControlMareas.App.Views"
             xmlns:vm="clr-namespace:ControlMareas.App.ViewModels"
             xmlns:controls="clr-namespace:ControlMareas.App.Controls"
             xmlns:models="clr-namespace:ControlMareas.App.Models"
             xmlns:conv="clr-namespace:ControlMareas.App.Converters"
             xmlns:system="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d" 
             d:DesignHeight="850" d:DesignWidth="1100">
    <UserControl.Resources>
        <conv:StringUpperConverter x:Key="StringUpperConverter" />
        <conv:EnhancedBooleanToVisibilityConverter x:Key="EnhancedBooleanToVisibilityConverter" />
        
        <ObjectDataProvider x:Key="TipoDatoCapturaEnum" MethodName="GetValues" ObjectType="{x:Type system:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:TipoDatoCaptura"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <ObjectDataProvider x:Key="TipoDatoDescarteEnum" MethodName="GetValues" ObjectType="{x:Type system:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:TipoDatoDescarte"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <Style x:Key="LanceCompactLabelStyle" TargetType="Label" BasedOn="{StaticResource FormLabelStyle}">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Margin" Value="0,0,0,2" />
        </Style>
        <Style x:Key="LanceCompactTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource PremiumTextBoxStyle}">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="8,4" />
        </Style>
    </UserControl.Resources>

    <UserControl.InputBindings>
        <KeyBinding Key="Esc" Command="{Binding CancelCommand}" />
    </UserControl.InputBindings>
    
    <AdornerDecorator>
        <Border Background="{DynamicResource ShellBackgroundBrush}"
                Padding="24,16"
                CornerRadius="0"
                MaxWidth="1260"
                Height="920"
                VerticalAlignment="Center"
                BorderBrush="{DynamicResource SidebarBorderBrush}"
                BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="60" Color="Black" Opacity="0.25" ShadowDepth="10" />
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /> <!-- Header -->
                    <RowDefinition Height="*" />    <!-- Content Area -->
                    <RowDefinition Height="Auto" /> <!-- Footer -->
                </Grid.RowDefinitions>

                <!-- 1. Header estilo Premium -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel>
                        <TextBlock Text="{Binding Title, Converter={StaticResource StringUpperConverter}}"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBrush}" />
                        <TextBlock Text="Carga de Planilla de Lance"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   Margin="0,2,0,0" />
                    </StackPanel>

                    <Border Grid.Column="1" 
                            Background="{DynamicResource SurfaceBackgroundBrush}" 
                            CornerRadius="0" 
                            Padding="16,8"
                            BorderBrush="{DynamicResource SidebarBorderBrush}"
                            BorderThickness="1"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                             <TextBlock Text="CAPTURA TOTAL" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" FontSize="10" FontWeight="Bold" Margin="0,0,10,0" />
                             <TextBlock Text="{Binding CapturaTotalKg, StringFormat={}{0:N0}}" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="18" VerticalAlignment="Center" />
                             <TextBlock Text=" KG" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" FontSize="10" FontWeight="Bold" Opacity="0.5" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 2. Main Area con Panel Lateral -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" /> 
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Margin="0,0,16,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /> <!-- Datos Grales (Style Planilla) -->
                            <RowDefinition Height="*" />    <!-- Tabla Especies -->
                        </Grid.RowDefinitions>                        <!-- SECCIÓN DATOS ARRASTRE -->
                        <Border Style="{StaticResource SurfaceBorderStyle}" 
                                Padding="14,10" 
                                Margin="0,0,0,16"
                                Visibility="{Binding EsPalangre, Converter={StaticResource EnhancedBooleanToVisibilityConverter}, ConverterParameter=invert}">
                            <Grid TextElement.FontSize="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="12" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- FILA 1 -->
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" /><ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="2*" /><ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="2*" /><ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="2*" /><ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="2*" /><ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="2*" /><ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="2*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel><Label Content="Nº Lance" Style="{StaticResource LanceCompactLabelStyle}" /><TextBox Text="{Binding NroLance}" Style="{StaticResource LanceCompactTextBoxStyle}" /></StackPanel>
                                    <StackPanel Grid.Column="2"><Label Content="Fecha Inicio" Style="{StaticResource LanceCompactLabelStyle}" /><controls:DatePickerPremium SelectedDate="{Binding Fecha}" Height="34" EsCompacto="True" /></StackPanel>
                                    <StackPanel Grid.Column="4"><Label Content="Hora Inicial" Style="{StaticResource LanceCompactLabelStyle}" /><controls:TimePickerPremium SelectedTime="{Binding HoraInicio}" Height="34" EsCompacto="True" /></StackPanel>
                                    <StackPanel Grid.Column="6"><Label Content="Fecha Final" Style="{StaticResource LanceCompactLabelStyle}" /><controls:DatePickerPremium SelectedDate="{Binding FechaFin}" Height="34" EsCompacto="True" /></StackPanel>
                                    <StackPanel Grid.Column="8"><Label Content="Hora Final" Style="{StaticResource LanceCompactLabelStyle}" /><controls:TimePickerPremium SelectedTime="{Binding HoraFinal}" Height="34" EsCompacto="True" /></StackPanel>
                                    <StackPanel Grid.Column="10"><Label Content="Lat. Inicio" Style="{StaticResource LanceCompactLabelStyle}" /><controls:CoordinatePickerPremium SelectedValue="{Binding LatitudInicioDecimal}" IsLatitude="True" Height="34" EsCompacto="True" /></StackPanel>
                                    <StackPanel Grid.Column="12"><Label Content="Lon. Inicio" Style="{StaticResource LanceCompactLabelStyle}" /><controls:CoordinatePickerPremium SelectedValue="{Binding LongitudInicioDecimal}" IsLatitude="False" Height="34" EsCompacto="True" /></StackPanel>
                                </Grid>

                                <!-- FILA 2 -->
                                <Grid Grid.Row="1" Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" /><ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="2*" /><ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="2*" /><ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="2*" /><ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="2*" /><ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="2*" /><ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="2*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel><Label Content="Lat. Final" Style="{StaticResource LanceCompactLabelStyle}" /><controls:CoordinatePickerPremium SelectedValue="{Binding LatitudFinalDecimal}" IsLatitude="True" Height="34" EsCompacto="True" /></StackPanel>
                                    <StackPanel Grid.Column="2"><Label Content="Lon. Final" Style="{StaticResource LanceCompactLabelStyle}" /><controls:CoordinatePickerPremium SelectedValue="{Binding LongitudFinalDecimal}" IsLatitude="False" Height="34" EsCompacto="True" /></StackPanel>
                                    <StackPanel Grid.Column="4"><Label Content="Prof. Inic (m)" Style="{StaticResource LanceCompactLabelStyle}" /><TextBox Text="{Binding ProfundidadInicioM}" Style="{StaticResource LanceCompactTextBoxStyle}" /></StackPanel>
                                    <StackPanel Grid.Column="6"><Label Content="Prof. Fin (m)" Style="{StaticResource LanceCompactLabelStyle}" /><TextBox Text="{Binding ProfundidadFinalM}" Style="{StaticResource LanceCompactTextBoxStyle}" /></StackPanel>
                                    <StackPanel Grid.Column="8"><Label Content="Viento Dir (°)" Style="{StaticResource LanceCompactLabelStyle}" /><TextBox Text="{Binding VientoDireccionGrados}" Style="{StaticResource LanceCompactTextBoxStyle}" /></StackPanel>
                                    <StackPanel Grid.Column="10"><Label Content="Viento Fza (Bft)" Style="{StaticResource LanceCompactLabelStyle}" /><TextBox Text="{Binding VientoFuerzaBeaufort}" Style="{StaticResource LanceCompactTextBoxStyle}" /></StackPanel>
                                    <StackPanel Grid.Column="12"><Label Content="Temp Aire (°C)" Style="{StaticResource LanceCompactLabelStyle}" /><TextBox Text="{Binding TemperaturaAireC}" Style="{StaticResource LanceCompactTextBoxStyle}" /></StackPanel>
                                </Grid>

                                <!-- FILA 3 -->
                                <Grid Grid.Row="2" Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" /><ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" /><ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" /><ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" /><ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" /><ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" /><ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" /><ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" /><ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" /><ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" /><ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" /><ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" /><ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" /><ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel><Label Content="Temp Red" Style="{StaticResource LanceCompactLabelStyle}" /><TextBox Text="{Binding TemperaturaRedC}" Style="{StaticResource LanceCompactTextBoxStyle}" /></StackPanel>
                                    <StackPanel Grid.Column="2"><Label Content="Est. Tiem" Style="{StaticResource LanceCompactLabelStyle}" /><TextBox Text="{Binding EstadoTiempoCodigo}" Style="{StaticResource LanceCompactTextBoxStyle}" /></StackPanel>
                                    <StackPanel Grid.Column="4"><Label Content="Est. Mar" Style="{StaticResource LanceCompactLabelStyle}" /><TextBox Text="{Binding EstadoMarCodigo}" Style="{StaticResource LanceCompactTextBoxStyle}" /></StackPanel>
                                    <StackPanel Grid.Column="6"><Label Content="Presion" Style="{StaticResource LanceCompactLabelStyle}" /><TextBox Text="{Binding PresionHpa}" Style="{StaticResource LanceCompactTextBoxStyle}" /></StackPanel>
                                    <StackPanel Grid.Column="8"><Label Content="Captura" Style="{StaticResource LanceCompactLabelStyle}" /><TextBox Text="{Binding CapturaTotalKg}" Style="{StaticResource LanceCompactTextBoxStyle}" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" /></StackPanel>
                                    <StackPanel Grid.Column="10"><Label Content="Arr. Vel" Style="{StaticResource LanceCompactLabelStyle}" /><TextBox Text="{Binding VelocidadArrastreNudos}" Style="{StaticResource LanceCompactTextBoxStyle}" /></StackPanel>
                                    <StackPanel Grid.Column="12"><Label Content="Arr. Rumbo" Style="{StaticResource LanceCompactLabelStyle}" /><TextBox Text="{Binding RumboGrados}" Style="{StaticResource LanceCompactTextBoxStyle}" /></StackPanel>
                                    <StackPanel Grid.Column="14"><Label Content="Malla Copo" Style="{StaticResource LanceCompactLabelStyle}" /><TextBox Text="{Binding MallaCopoMm}" Style="{StaticResource LanceCompactTextBoxStyle}" /></StackPanel>
                                    <StackPanel Grid.Column="16"><Label Content="Malla Alas" Style="{StaticResource LanceCompactLabelStyle}" /><TextBox Text="{Binding MallaAlasMm}" Style="{StaticResource LanceCompactTextBoxStyle}" /></StackPanel>
                                    <StackPanel Grid.Column="18"><Label Content="Cable Fil." Style="{StaticResource LanceCompactLabelStyle}" /><TextBox Text="{Binding CableFiladoM}" Style="{StaticResource LanceCompactTextBoxStyle}" /></StackPanel>
                                    <StackPanel Grid.Column="20"><Label Content="Abert. Vert" Style="{StaticResource LanceCompactLabelStyle}" /><TextBox Text="{Binding AberturaVerticalM}" Style="{StaticResource LanceCompactTextBoxStyle}" /></StackPanel>
                                    <StackPanel Grid.Column="22"><Label Content="Dist. Alas" Style="{StaticResource LanceCompactLabelStyle}" /><TextBox Text="{Binding DistanciaAlasM}" Style="{StaticResource LanceCompactTextBoxStyle}" /></StackPanel>
                                    <StackPanel Grid.Column="24"><Label Content="Dist. Port." Style="{StaticResource LanceCompactLabelStyle}" /><TextBox Text="{Binding DistanciaPortonesM}" Style="{StaticResource LanceCompactTextBoxStyle}" /></StackPanel>
                                    <StackPanel Grid.Column="26"><Label Content="Selectividad" Style="{StaticResource LanceCompactLabelStyle}" /><CheckBox IsChecked="{Binding Selectividad}" HorizontalAlignment="Center" Margin="0,10,0,0" /></StackPanel>
                                </Grid>

                                <!-- FILA COMENTARIOS -->
                                <Grid Grid.Row="4">
                                    <StackPanel>
                                        <Label Content="Comentarios / Observaciones" Style="{StaticResource LanceCompactLabelStyle}" />
                                        <TextBox Text="{Binding Comentarios}"
                                                 Style="{StaticResource LanceCompactTextBoxStyle}"
                                                 Height="56"
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 VerticalScrollBarVisibility="Auto"
                                                 HorizontalContentAlignment="Left"
                                                 VerticalContentAlignment="Top"
                                                 Padding="8,4" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- SECCIÓN DATOS PALANGRE -->
                        <Border Style="{StaticResource SurfaceBorderStyle}" 
                                Padding="14,10" 
                                Margin="0,0,0,16"
                                Visibility="{Binding EsPalangre, Converter={StaticResource EnhancedBooleanToVisibilityConverter}}">
                            <Grid TextElement.FontSize="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- FILA 0: CABECERA PALANGRE -->
                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100" /><ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="150" /><ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="150" /><ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="110" /><ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>
                                        <Label Content="Nº Lance" Style="{StaticResource LanceCompactLabelStyle}" />
                                        <TextBox Text="{Binding NroLance}" Style="{StaticResource LanceCompactTextBoxStyle}" FontWeight="Bold" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <Label Content="Identificación (Indicativo)" Style="{StaticResource LanceCompactLabelStyle}" />
                                        <TextBox Text="{Binding Identificacion}" Style="{StaticResource LanceCompactTextBoxStyle}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <Label Content="Tipo Palangre" Style="{StaticResource LanceCompactLabelStyle}" />
                                        <TextBox Text="{Binding TipoPalangre}" Style="{StaticResource LanceCompactTextBoxStyle}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="6">
                                        <Label Content="Presión (hPa)" Style="{StaticResource LanceCompactLabelStyle}" />
                                        <TextBox Text="{Binding PresionHpa}" Style="{StaticResource LanceCompactTextBoxStyle}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="8">
                                        <Label Content="Captura Lance (Kg)" Style="{StaticResource LanceCompactLabelStyle}" />
                                        <TextBox Text="{Binding CapturaTotalKg}" Style="{StaticResource LanceCompactTextBoxStyle}" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                                    </StackPanel>
                                </Grid>

                                <!-- FILA 1: FILADO Y VIRADO EN 2 BLOQUES LADO A LADO -->
                                <Grid Grid.Row="1" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- BLOQUE FILADO -->
                                    <Border Background="{DynamicResource SurfaceBackgroundBrush}" 
                                            BorderBrush="{DynamicResource SidebarBorderBrush}" 
                                            BorderThickness="1" 
                                            Padding="10,6">
                                        <StackPanel>
                                            <TextBlock Text="FILADO (CALADO)" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource SuccessForegroundBrush}" Margin="0,0,0,6"/>
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="2*" /><ColumnDefinition Width="6" />
                                                    <ColumnDefinition Width="1.5*" /><ColumnDefinition Width="6" />
                                                    <ColumnDefinition Width="1.5*" /><ColumnDefinition Width="6" />
                                                    <ColumnDefinition Width="1.3*" /><ColumnDefinition Width="6" />
                                                    <ColumnDefinition Width="1.3*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <Label Content="Fecha Filado" Style="{StaticResource LanceCompactLabelStyle}" />
                                                    <controls:DatePickerPremium SelectedDate="{Binding Fecha}" Height="34" EsCompacto="True" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <Label Content="Hora Ini" Style="{StaticResource LanceCompactLabelStyle}" />
                                                    <controls:TimePickerPremium SelectedTime="{Binding HoraInicioFilado}" Height="34" EsCompacto="True" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="4">
                                                    <Label Content="Hora Fin" Style="{StaticResource LanceCompactLabelStyle}" />
                                                    <controls:TimePickerPremium SelectedTime="{Binding HoraFinFilado}" Height="34" EsCompacto="True" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="6">
                                                    <Label Content="Prof. Ini (m)" Style="{StaticResource LanceCompactLabelStyle}" />
                                                    <TextBox Text="{Binding ProfundidadInicioFiladoM}" Style="{StaticResource LanceCompactTextBoxStyle}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="8">
                                                    <Label Content="Prof. Fin (m)" Style="{StaticResource LanceCompactLabelStyle}" />
                                                    <TextBox Text="{Binding ProfundidadFinFiladoM}" Style="{StaticResource LanceCompactTextBoxStyle}" />
                                                </StackPanel>
                                            </Grid>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="6" />
                                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="6" />
                                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="6" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <Label Content="Lat. Inicio Filado" Style="{StaticResource LanceCompactLabelStyle}" />
                                                    <controls:CoordinatePickerPremium SelectedValue="{Binding LatitudInicioFiladoDecimal}" IsLatitude="True" Height="34" EsCompacto="True" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <Label Content="Lon. Inicio Filado" Style="{StaticResource LanceCompactLabelStyle}" />
                                                    <controls:CoordinatePickerPremium SelectedValue="{Binding LongitudInicioFiladoDecimal}" IsLatitude="False" Height="34" EsCompacto="True" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="4">
                                                    <Label Content="Lat. Fin Filado" Style="{StaticResource LanceCompactLabelStyle}" />
                                                    <controls:CoordinatePickerPremium SelectedValue="{Binding LatitudFinFiladoDecimal}" IsLatitude="True" Height="34" EsCompacto="True" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="6">
                                                    <Label Content="Lon. Fin Filado" Style="{StaticResource LanceCompactLabelStyle}" />
                                                    <controls:CoordinatePickerPremium SelectedValue="{Binding LongitudFinFiladoDecimal}" IsLatitude="False" Height="34" EsCompacto="True" />
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- BLOQUE VIRADO -->
                                    <Border Grid.Column="2"
                                            Background="{DynamicResource SurfaceBackgroundBrush}" 
                                            BorderBrush="{DynamicResource SidebarBorderBrush}" 
                                            BorderThickness="1" 
                                            Padding="10,6">
                                        <StackPanel>
                                            <TextBlock Text="VIRADO" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,6"/>
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="2*" /><ColumnDefinition Width="6" />
                                                    <ColumnDefinition Width="1.5*" /><ColumnDefinition Width="6" />
                                                    <ColumnDefinition Width="1.5*" /><ColumnDefinition Width="6" />
                                                    <ColumnDefinition Width="1.2*" /><ColumnDefinition Width="6" />
                                                    <ColumnDefinition Width="1.2*" /><ColumnDefinition Width="6" />
                                                    <ColumnDefinition Width="1.2*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <Label Content="Fecha Virado" Style="{StaticResource LanceCompactLabelStyle}" />
                                                    <controls:DatePickerPremium SelectedDate="{Binding FechaVirado}" Height="34" EsCompacto="True" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <Label Content="Hora Ini" Style="{StaticResource LanceCompactLabelStyle}" />
                                                    <controls:TimePickerPremium SelectedTime="{Binding HoraInicioVirado}" Height="34" EsCompacto="True" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="4">
                                                    <Label Content="Hora Fin" Style="{StaticResource LanceCompactLabelStyle}" />
                                                    <controls:TimePickerPremium SelectedTime="{Binding HoraFinVirado}" Height="34" EsCompacto="True" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="6">
                                                    <Label Content="Prof. Ini (m)" Style="{StaticResource LanceCompactLabelStyle}" />
                                                    <TextBox Text="{Binding ProfundidadInicioViradoM}" Style="{StaticResource LanceCompactTextBoxStyle}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="8">
                                                    <Label Content="Prof. Fin (m)" Style="{StaticResource LanceCompactLabelStyle}" />
                                                    <TextBox Text="{Binding ProfundidadFinViradoM}" Style="{StaticResource LanceCompactTextBoxStyle}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="10">
                                                    <Label Content="Rumbo (°)" Style="{StaticResource LanceCompactLabelStyle}" />
                                                    <TextBox Text="{Binding RumboViradoGrados}" Style="{StaticResource LanceCompactTextBoxStyle}" />
                                                </StackPanel>
                                            </Grid>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="6" />
                                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="6" />
                                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="6" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <Label Content="Lat. Inicio Virado" Style="{StaticResource LanceCompactLabelStyle}" />
                                                    <controls:CoordinatePickerPremium SelectedValue="{Binding LatitudInicioViradoDecimal}" IsLatitude="True" Height="34" EsCompacto="True" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <Label Content="Lon. Inicio Virado" Style="{StaticResource LanceCompactLabelStyle}" />
                                                    <controls:CoordinatePickerPremium SelectedValue="{Binding LongitudInicioViradoDecimal}" IsLatitude="False" Height="34" EsCompacto="True" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="4">
                                                    <Label Content="Lat. Fin Virado" Style="{StaticResource LanceCompactLabelStyle}" />
                                                    <controls:CoordinatePickerPremium SelectedValue="{Binding LatitudFinViradoDecimal}" IsLatitude="True" Height="34" EsCompacto="True" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="6">
                                                    <Label Content="Lon. Fin Virado" Style="{StaticResource LanceCompactLabelStyle}" />
                                                    <controls:CoordinatePickerPremium SelectedValue="{Binding LongitudFinViradoDecimal}" IsLatitude="False" Height="34" EsCompacto="True" />
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- FILA 2: ARTES DE PESCA -->
                                <Border Grid.Row="2" 
                                        Background="{DynamicResource SurfaceBackgroundBrush}" 
                                        BorderBrush="{DynamicResource SidebarBorderBrush}" 
                                        BorderThickness="1" 
                                        Padding="10,6" 
                                        Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="ARTES DE PESCA (LÍNEA MADRE, BRAZOLADAS Y ANZUELOS)" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,6"/>
                                        <Grid Grid.Row="1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.2*" /><ColumnDefinition Width="6" />
                                                <ColumnDefinition Width="*" /><ColumnDefinition Width="6" />
                                                <ColumnDefinition Width="*" /><ColumnDefinition Width="10" />
                                                <ColumnDefinition Width="*" /><ColumnDefinition Width="6" />
                                                <ColumnDefinition Width="*" /><ColumnDefinition Width="6" />
                                                <ColumnDefinition Width="*" /><ColumnDefinition Width="10" />
                                                <ColumnDefinition Width="1.2*" /><ColumnDefinition Width="6" />
                                                <ColumnDefinition Width="*" /><ColumnDefinition Width="6" />
                                                <ColumnDefinition Width="*" /><ColumnDefinition Width="6" />
                                                <ColumnDefinition Width="1.2*" /><ColumnDefinition Width="6" />
                                                <ColumnDefinition Width="*" /><ColumnDefinition Width="6" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel><Label Content="LM Mater." Style="{StaticResource LanceCompactLabelStyle}" /><TextBox Text="{Binding Material}" Style="{StaticResource LanceCompactTextBoxStyle}" /></StackPanel>
                                            <StackPanel Grid.Column="2"><Label Content="LM Largo (m)" Style="{StaticResource LanceCompactLabelStyle}" /><TextBox Text="{Binding LmLargoM}" Style="{StaticResource LanceCompactTextBoxStyle}" /></StackPanel>
                                            <StackPanel Grid.Column="4"><Label Content="LM Tramos" Style="{StaticResource LanceCompactLabelStyle}" /><TextBox Text="{Binding LmTramos}" Style="{StaticResource LanceCompactTextBoxStyle}" /></StackPanel>

                                            <StackPanel Grid.Column="6"><Label Content="Brz Largo" Style="{StaticResource LanceCompactLabelStyle}" /><TextBox Text="{Binding BrzLargoM}" Style="{StaticResource LanceCompactTextBoxStyle}" /></StackPanel>
                                            <StackPanel Grid.Column="8"><Label Content="Brz Separ. (m)" Style="{StaticResource LanceCompactLabelStyle}" /><TextBox Text="{Binding BrzSeparacionM}" Style="{StaticResource LanceCompactTextBoxStyle}" /></StackPanel>
                                            <StackPanel Grid.Column="10"><Label Content="Brz N/Tramo" Style="{StaticResource LanceCompactLabelStyle}" /><TextBox Text="{Binding BrzNxTramo}" Style="{StaticResource LanceCompactTextBoxStyle}" /></StackPanel>

                                            <StackPanel Grid.Column="12"><Label Content="Anz. Tipo" Style="{StaticResource LanceCompactLabelStyle}" /><TextBox Text="{Binding AnzuelosTipo}" Style="{StaticResource LanceCompactTextBoxStyle}" /></StackPanel>
                                            <StackPanel Grid.Column="14"><Label Content="Largo (mm)" Style="{StaticResource LanceCompactLabelStyle}" /><TextBox Text="{Binding AnzuelosLargoMm}" Style="{StaticResource LanceCompactTextBoxStyle}" /></StackPanel>
                                            <StackPanel Grid.Column="16"><Label Content="Ancho (mm)" Style="{StaticResource LanceCompactLabelStyle}" /><TextBox Text="{Binding AnzuelosAnchoMm}" Style="{StaticResource LanceCompactTextBoxStyle}" /></StackPanel>
                                            <StackPanel Grid.Column="18"><Label Content="Anz. Total" Style="{StaticResource LanceCompactLabelStyle}" /><TextBox Text="{Binding AnzuelosTotal}" Style="{StaticResource LanceCompactTextBoxStyle}" FontWeight="Bold" /></StackPanel>
                                            <StackPanel Grid.Column="20"><Label Content="C/Carnada" Style="{StaticResource LanceCompactLabelStyle}" /><TextBox Text="{Binding AnzuelosConCarnada}" Style="{StaticResource LanceCompactTextBoxStyle}" /></StackPanel>
                                            <StackPanel Grid.Column="22"><Label Content="S/Carnada" Style="{StaticResource LanceCompactLabelStyle}" /><TextBox Text="{Binding AnzuelosSinCarnada}" Style="{StaticResource LanceCompactTextBoxStyle}" /></StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>

                                <!-- FILA 3: CARNADA Y CONDICIONES AMBIENTALES -->
                                <Grid Grid.Row="3" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" /><ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" /><ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" /><ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" /><ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" /><ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" /><ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel><Label Content="Carnada" Style="{StaticResource LanceCompactLabelStyle}" /><TextBox Text="{Binding Carnada}" Style="{StaticResource LanceCompactTextBoxStyle}" /></StackPanel>
                                    <StackPanel Grid.Column="2"><Label Content="Est. Tiempo" Style="{StaticResource LanceCompactLabelStyle}" /><TextBox Text="{Binding EstadoTiempoCodigo}" Style="{StaticResource LanceCompactTextBoxStyle}" /></StackPanel>
                                    <StackPanel Grid.Column="4"><Label Content="Est. Mar" Style="{StaticResource LanceCompactLabelStyle}" /><TextBox Text="{Binding EstadoMarCodigo}" Style="{StaticResource LanceCompactTextBoxStyle}" /></StackPanel>
                                    <StackPanel Grid.Column="6"><Label Content="Viento Dir (°)" Style="{StaticResource LanceCompactLabelStyle}" /><TextBox Text="{Binding VientoDireccionGrados}" Style="{StaticResource LanceCompactTextBoxStyle}" /></StackPanel>
                                    <StackPanel Grid.Column="8"><Label Content="Viento Fza (n)" Style="{StaticResource LanceCompactLabelStyle}" /><TextBox Text="{Binding VientoFuerzaBeaufort}" Style="{StaticResource LanceCompactTextBoxStyle}" /></StackPanel>
                                    <StackPanel Grid.Column="10"><Label Content="Temp Aire (°C)" Style="{StaticResource LanceCompactLabelStyle}" /><TextBox Text="{Binding TemperaturaAireC}" Style="{StaticResource LanceCompactTextBoxStyle}" /></StackPanel>
                                    <StackPanel Grid.Column="12"><Label Content="Temp Mar Sup (°C)" Style="{StaticResource LanceCompactLabelStyle}" /><TextBox Text="{Binding TemperaturaRedC}" Style="{StaticResource LanceCompactTextBoxStyle}" /></StackPanel>
                                </Grid>

                                <!-- FILA 4: COMENTARIOS -->
                                <Grid Grid.Row="4">
                                    <StackPanel>
                                        <Label Content="Comentarios / Observaciones" Style="{StaticResource LanceCompactLabelStyle}" />
                                        <TextBox Text="{Binding Comentarios}"
                                                 Style="{StaticResource LanceCompactTextBoxStyle}"
                                                 Height="46"
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 VerticalScrollBarVisibility="Auto"
                                                 HorizontalContentAlignment="Left"
                                                 VerticalContentAlignment="Top"
                                                 Padding="8,4" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                        <!-- Tabla Especies -->
                        <Border Grid.Row="1" Style="{StaticResource SurfaceBorderStyle}" Padding="0" ClipToBounds="True">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Border Background="{DynamicResource SurfaceBackgroundBrush}" Padding="16,10" BorderBrush="{DynamicResource SidebarBorderBrush}" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <TextBlock Text="ESPECIES CAPTURADAS" Style="{StaticResource SectionHeaderStyle}" VerticalAlignment="Center" FontSize="11" />
                                        <Button HorizontalAlignment="Right" 
                                                Command="{Binding AddCatchItemCommand}"
                                                Style="{StaticResource ThemeButtonStyle}"
                                                Foreground="{DynamicResource AccentBrush}"
                                                Padding="12,6">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="+ " FontWeight="Bold" />
                                                <TextBlock Text="AGREGAR ESPECIE" FontSize="12" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>

                                <DataGrid Grid.Row="1" 
                                          ItemsSource="{Binding ItemsCaptura}" 
                                          SelectedItem="{Binding SelectedCatchItem}"
                                          Style="{StaticResource PremiumDataGridStyle}"
                                          IsReadOnly="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="ORD" Binding="{Binding NumeroOrden}" Width="40" ElementStyle="{StaticResource DataGridTextCenter}" />
                                        <DataGridTextColumn Header="ESPECIE" Binding="{Binding EspecieDisplayFullName}" Width="*" FontWeight="SemiBold" FontSize="13" ElementStyle="{StaticResource DataGridTextLeft}" />
                                        <DataGridTextColumn Header="CAPTURA" Binding="{Binding DatoCapturaDisplay}" Width="110" ElementStyle="{StaticResource DataGridTextRight}" HeaderStyle="{StaticResource PremiumDataGridColumnHeaderRightStyle}" />
                                        <DataGridTextColumn Header="PIEZAS" Binding="{Binding PiezasDisplay}" Width="80" ElementStyle="{StaticResource DataGridTextRight}" HeaderStyle="{StaticResource PremiumDataGridColumnHeaderRightStyle}" />
                                        <DataGridTextColumn Header="DESC. (%)" Binding="{Binding DatoDescartePorcentajeDisplay}" Width="100" ElementStyle="{StaticResource DataGridTextRight}" HeaderStyle="{StaticResource PremiumDataGridColumnHeaderRightStyle}" Foreground="{DynamicResource SecondaryTextBrush}" />
                                        <DataGridTextColumn Header="DESC. (KG)" Binding="{Binding DatoDescarteKilosDisplay}" Width="110" ElementStyle="{StaticResource DataGridTextRight}" HeaderStyle="{StaticResource PremiumDataGridColumnHeaderRightStyle}" FontWeight="SemiBold" />
                                        <DataGridTemplateColumn Width="60">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button PreviewMouseDown="RemoveButton_PreviewMouseDown"
                                                            Content="✕"
                                                            Style="{StaticResource ThemeButtonStyle}"
                                                            Foreground="{DynamicResource DangerForegroundBrush}"
                                                            HorizontalAlignment="Center"
                                                            Padding="8,2"
                                                            FontSize="11" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <Border Grid.Row="2" Padding="20,10" Background="{DynamicResource SurfaceBackgroundBrush}" BorderBrush="{DynamicResource SidebarBorderBrush}" BorderThickness="0,1,0,0">
                                    <TextBlock Text="{Binding ItemsCaptura.Count, StringFormat='{}Total registros: {0}'}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" />
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Panel Lateral (Edición de Especie) -->
                    <Border Grid.Column="1" 
                            Width="340" 
                            Style="{StaticResource SurfaceBorderStyle}"
                            Background="{DynamicResource ShellBackgroundBrush}" 
                            Visibility="{Binding HasSelectedCatchItem, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border Background="{DynamicResource AccentMutedBrush}" Padding="24,20" BorderBrush="{DynamicResource SidebarBorderBrush}" BorderThickness="0,0,0,1">
                                <StackPanel>
                                    <TextBlock Text="EDITAR ESPECIE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                                    <TextBlock Text="{Binding SelectedCatchItem.EspecieNombreVulgar}" 
                                               FontSize="18" FontWeight="SemiBold" 
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               Margin="0,4,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <ScrollViewer Grid.Row="1" Style="{StaticResource SlimScrollViewerStyle}" Padding="24">
                                <StackPanel>
                                    <controls:SpeciesSelectorPremium 
                                        Label="Buscador de Especie"
                                        ItemsSource="{Binding AllEspecies}"
                                        SelectedItem="{Binding SelectedCatchItem.SelectedEspecie}"
                                        Margin="0,0,0,24" />

                                    <TextBlock Text="CAPTURA" FontWeight="Bold" FontSize="10" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,12"/>
                                    <Grid Margin="0,0,0,20">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="140" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding SelectedCatchItem.DatoCaptura}" Style="{StaticResource PremiumTextBoxStyle}" />
                                        <ComboBox Grid.Column="2"
                                                  ItemsSource="{Binding Source={StaticResource TipoDatoCapturaEnum}}"
                                                  SelectedItem="{Binding SelectedCatchItem.TipoDatoCaptura}"
                                                  Style="{StaticResource PremiumComboBoxStyle}" />
                                    </Grid>

                                    <TextBlock Text="PIEZAS (UNIDADES)" FontWeight="Bold" FontSize="10" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,8"/>
                                    <TextBox Text="{Binding SelectedCatchItem.Piezas, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource PremiumTextBoxStyle}" Margin="0,0,0,20" />

                                    <TextBlock Text="DESCARTE" FontWeight="Bold" FontSize="10" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,12"/>
                                    <Grid Margin="0,0,0,24">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="140" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding SelectedCatchItem.DatoDescarte}" Style="{StaticResource PremiumTextBoxStyle}" />
                                        <ComboBox Grid.Column="2"
                                                  ItemsSource="{Binding Source={StaticResource TipoDatoDescarteEnum}}"
                                                  SelectedItem="{Binding SelectedCatchItem.TipoDatoDescarte}"
                                                  Style="{StaticResource PremiumComboBoxStyle}" />
                                    </Grid>
                                </StackPanel>
                            </ScrollViewer>

                            <Border Grid.Row="2" Padding="24" BorderBrush="{DynamicResource SidebarBorderBrush}" BorderThickness="0,1,0,0">
                                <Button Content="CERRAR EDICIÓN"
                                        Click="CerrarEdicion_Click"
                                        Style="{StaticResource ThemeButtonStyle}"
                                        Foreground="{DynamicResource AccentBrush}"
                                        HorizontalAlignment="Stretch" FontSize="12" />
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <controls:FormActionBar Grid.Row="2"
                                        SaveCommand="{Binding SaveCommand}"
                                        CancelCommand="{Binding CancelCommand}"
                                        SaveContent="GUARDAR LANCE">
                    <controls:FormActionBar.AdditionalContent>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0">
                            <Button Content="Anterior" 
                                    Command="{Binding MovePreviousCommand}" 
                                    Style="{StaticResource ThemeButtonStyle}"
                                    Width="100" Margin="0,0,8,0"/>
                            <Button Content="Siguiente" 
                                    Command="{Binding MoveNextCommand}" 
                                    Style="{StaticResource ThemeButtonStyle}"
                                    Width="100"/>
                        </StackPanel>
                    </controls:FormActionBar.AdditionalContent>
                </controls:FormActionBar>
            </Grid>
        </Border>
    </AdornerDecorator>
</UserControl>

