<UserControl x:Class="ControlMareas.App.Views.LanceEditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ControlMareas.App.Views"
             xmlns:vm="clr-namespace:ControlMareas.App.ViewModels"
             xmlns:controls="clr-namespace:ControlMareas.App.Controls"
             xmlns:models="clr-namespace:ControlMareas.App.Models"
             xmlns:conv="clr-namespace:ControlMareas.App.Converters"
             xmlns:system="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d" 
             d:DesignHeight="850" d:DesignWidth="1100">
    <UserControl.Resources>
        <conv:StringUpperConverter x:Key="StringUpperConverter" />
        
        <ObjectDataProvider x:Key="TipoDatoCapturaEnum" MethodName="GetValues" ObjectType="{x:Type system:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:TipoDatoCaptura"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <ObjectDataProvider x:Key="TipoDatoDescarteEnum" MethodName="GetValues" ObjectType="{x:Type system:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:TipoDatoDescarte"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <!-- Estilos Locales Ultra Compactos (Estilo Planilla de Papel) -->
        <Style x:Key="PaperLabelStyle" TargetType="Label" BasedOn="{StaticResource FormLabelStyle}">
            <Setter Property="FontSize" Value="9" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="2,0" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>

        <Style x:Key="PaperTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource PremiumTextBoxStyle}">
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Height" Value="28" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="PaperHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource SectionHeaderStyle}">
            <Setter Property="FontSize" Value="9" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBackgroundBrush}" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,0,2" />
        </Style>


    </UserControl.Resources>

    <UserControl.InputBindings>
        <KeyBinding Key="Esc" Command="{Binding CancelCommand}" />
    </UserControl.InputBindings>
    
    <AdornerDecorator>
        <Border Background="{DynamicResource ShellBackgroundBrush}"
                Padding="30,20"
                CornerRadius="0"
                MaxWidth="1180"
                Height="850"
                VerticalAlignment="Center"
                BorderBrush="{DynamicResource SidebarBorderBrush}"
                BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="60" Color="Black" Opacity="0.25" ShadowDepth="10" />
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /> <!-- Header -->
                    <RowDefinition Height="*" />    <!-- Content Area -->
                    <RowDefinition Height="Auto" /> <!-- Footer -->
                </Grid.RowDefinitions>

                <!-- 1. Header estilo Premium -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel>
                        <TextBlock Text="{Binding Title, Converter={StaticResource StringUpperConverter}}"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBrush}" />
                        <TextBlock Text="Carga de Planilla de Lance"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   Margin="0,2,0,0" />
                    </StackPanel>

                    <Border Grid.Column="1" 
                            Background="{DynamicResource SurfaceBackgroundBrush}" 
                            CornerRadius="0" 
                            Padding="16,8"
                            BorderBrush="{DynamicResource SidebarBorderBrush}"
                            BorderThickness="1"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                             <TextBlock Text="CAPTURA TOTAL" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" FontSize="10" FontWeight="Bold" Margin="0,0,10,0" />
                             <TextBlock Text="{Binding CapturaTotalKg, StringFormat={}{0:N0}}" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="18" VerticalAlignment="Center" />
                             <TextBlock Text=" KG" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" FontSize="10" FontWeight="Bold" Opacity="0.5" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 2. Main Area con Panel Lateral -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" /> 
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Margin="0,0,16,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /> <!-- Datos Grales (Style Planilla) -->
                            <RowDefinition Height="*" />    <!-- Tabla Especies -->
                        </Grid.RowDefinitions>

                        <!-- SECCIÓN DATOS GENERALES (MIMETIC A LA PLANILLA DE PAPEL) -->
                        <Border Style="{StaticResource SurfaceBorderStyle}" Padding="16" Margin="0,0,0,16">
                            <Grid TextElement.FontSize="11">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" /> <!-- Fila 1: Fecha, Lance, Hora, Estado, Ubic -->
                                    <RowDefinition Height="Auto" /> <!-- Separador -->
                                    <RowDefinition Height="Auto" /> <!-- Fila 2: Prof, Viento, Temp, Pres, Capt -->
                                    <RowDefinition Height="Auto" /> <!-- Separador -->
                                    <RowDefinition Height="Auto" /> <!-- Fila 3: Arrastre, Malla, Cable, AbV, DistA, ProfA -->
                                    <RowDefinition Height="Auto" /> <!-- Separador -->
                                    <RowDefinition Height="Auto" /> <!-- Fila 4: Comentarios -->
                                </Grid.RowDefinitions>

                                <!-- FILA 1 DE LA PLANILLA PAPEL -->
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" /> <!-- Fecha -->
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="Auto" /> <!-- N° Lance -->
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="Auto" /> <!-- Hora -->
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="Auto" /> <!-- Estado -->
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="*" />    <!-- Ubicación -->
                                    </Grid.ColumnDefinitions>

                                    <!-- FECHA -->
                                    <StackPanel>
                                        <TextBlock Text="FECHA" Style="{StaticResource PaperHeaderStyle}" />
                                        <controls:DatePickerPremium SelectedDate="{Binding Fecha}" Width="120" Height="28" EsCompacto="True" />
                                    </StackPanel>

                                    <!-- N° LANCE -->
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="N° LANCE" Style="{StaticResource PaperHeaderStyle}" />
                                        <TextBox Text="{Binding NroLance}" Style="{StaticResource PaperTextBoxStyle}" Width="60" />
                                    </StackPanel>

                                    <!-- HORA -->
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="HORA" Style="{StaticResource PaperHeaderStyle}" />
                                        <UniformGrid Columns="2">
                                            <StackPanel Margin="0,0,4,0">
                                                <Label Content="INICIAL" Style="{StaticResource PaperLabelStyle}" />
                                                <controls:TimePickerPremium SelectedTime="{Binding HoraInicio}" Width="80" Height="28" EsCompacto="True" />
                                            </StackPanel>
                                            <StackPanel>
                                                <Label Content="FINAL" Style="{StaticResource PaperLabelStyle}" />
                                                <controls:TimePickerPremium SelectedTime="{Binding HoraFinal}" Width="80" Height="28" EsCompacto="True" />
                                            </StackPanel>
                                        </UniformGrid>
                                    </StackPanel>

                                    <!-- ESTADO -->
                                    <StackPanel Grid.Column="6">
                                        <TextBlock Text="ESTADO" Style="{StaticResource PaperHeaderStyle}" />
                                        <UniformGrid Columns="2">
                                            <StackPanel Margin="0,0,4,0">
                                                <Label Content="TIEM" Style="{StaticResource PaperLabelStyle}" />
                                                <TextBox Text="{Binding EstadoTiempoCodigo}" Style="{StaticResource PaperTextBoxStyle}" Width="45" />
                                            </StackPanel>
                                            <StackPanel>
                                                <Label Content="MAR" Style="{StaticResource PaperLabelStyle}" />
                                                <TextBox Text="{Binding EstadoMarCodigo}" Style="{StaticResource PaperTextBoxStyle}" Width="45" />
                                            </StackPanel>
                                        </UniformGrid>
                                    </StackPanel>

                                    <!-- UBICACION -->
                                    <StackPanel Grid.Column="8">
                                        <TextBlock Text="UBICACION" Style="{StaticResource PaperHeaderStyle}" />
                                        <UniformGrid Columns="4">
                                            <StackPanel Margin="0,0,4,0">
                                                <Label Content="LAT. INIC" Style="{StaticResource PaperLabelStyle}" />
                                                <controls:CoordinatePickerPremium SelectedValue="{Binding LatitudInicioDecimal}" IsLatitude="True" Height="28" EsCompacto="True" />
                                            </StackPanel>
                                            <StackPanel Margin="0,0,4,0">
                                                <Label Content="LON. INIC" Style="{StaticResource PaperLabelStyle}" />
                                                <controls:CoordinatePickerPremium SelectedValue="{Binding LongitudInicioDecimal}" IsLatitude="False" Height="28" EsCompacto="True" />
                                            </StackPanel>
                                            <StackPanel Margin="0,0,4,0">
                                                <Label Content="LAT. FIN" Style="{StaticResource PaperLabelStyle}" />
                                                <controls:CoordinatePickerPremium SelectedValue="{Binding LatitudFinalDecimal}" IsLatitude="True" Height="28" EsCompacto="True" />
                                            </StackPanel>
                                            <StackPanel>
                                                <Label Content="LON. FIN" Style="{StaticResource PaperLabelStyle}" />
                                                <controls:CoordinatePickerPremium SelectedValue="{Binding LongitudFinalDecimal}" IsLatitude="False" Height="28" EsCompacto="True" />
                                            </StackPanel>
                                        </UniformGrid>
                                    </StackPanel>
                                </Grid>

                                <Border Grid.Row="1" Height="20" />

                                <!-- FILA 2 DE LA PLANILLA PAPEL -->
                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" /> <!-- Profundidad -->
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="Auto" /> <!-- Viento -->
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="Auto" /> <!-- Temp -->
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="Auto" /> <!-- Presion -->
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="*" />    <!-- Captura Total -->
                                    </Grid.ColumnDefinitions>

                                    <!-- PROFUNDIDAD (m) -->
                                    <StackPanel>
                                        <TextBlock Text="PROFUNDIDAD (m)" Style="{StaticResource PaperHeaderStyle}" />
                                        <UniformGrid Columns="2">
                                            <StackPanel Margin="0,0,4,0">
                                                <Label Content="INICIAL" Style="{StaticResource PaperLabelStyle}" />
                                                <TextBox Text="{Binding ProfundidadInicioM}" Style="{StaticResource PaperTextBoxStyle}" Width="65" />
                                            </StackPanel>
                                            <StackPanel>
                                                <Label Content="FINAL" Style="{StaticResource PaperLabelStyle}" />
                                                <TextBox Text="{Binding ProfundidadFinalM}" Style="{StaticResource PaperTextBoxStyle}" Width="65" />
                                            </StackPanel>
                                        </UniformGrid>
                                    </StackPanel>

                                    <!-- VIENTO -->
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="VIENTO" Style="{StaticResource PaperHeaderStyle}" />
                                        <UniformGrid Columns="2">
                                            <StackPanel Margin="0,0,4,0">
                                                <Label Content="DIREC" Style="{StaticResource PaperLabelStyle}" />
                                                <TextBox Text="{Binding VientoDireccionGrados}" Style="{StaticResource PaperTextBoxStyle}" Width="60" />
                                            </StackPanel>
                                            <StackPanel>
                                                <Label Content="FUERZA" Style="{StaticResource PaperLabelStyle}" />
                                                <TextBox Text="{Binding VientoFuerzaBeaufort}" Style="{StaticResource PaperTextBoxStyle}" Width="60" />
                                            </StackPanel>
                                        </UniformGrid>
                                    </StackPanel>

                                    <!-- TEMPERATURA (C°) -->
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="TEMPERATURA (C°)" Style="{StaticResource PaperHeaderStyle}" />
                                        <UniformGrid Columns="2">
                                            <StackPanel Margin="0,0,4,0">
                                                <Label Content="AIRE" Style="{StaticResource PaperLabelStyle}" />
                                                <TextBox Text="{Binding TemperaturaAireC}" Style="{StaticResource PaperTextBoxStyle}" Width="60" />
                                            </StackPanel>
                                            <StackPanel>
                                                <Label Content="RED" Style="{StaticResource PaperLabelStyle}" />
                                                <TextBox Text="{Binding TemperaturaRedC}" Style="{StaticResource PaperTextBoxStyle}" Width="60" />
                                            </StackPanel>
                                        </UniformGrid>
                                    </StackPanel>

                                    <!-- PRESION (mb) -->
                                    <StackPanel Grid.Column="6">
                                        <TextBlock Text="PRESION (mb)" Style="{StaticResource PaperHeaderStyle}" />
                                        <Border Height="13" /> <!-- Alineación con los que tienen sub-etiquetas -->
                                        <TextBox Text="{Binding PresionHpa}" Style="{StaticResource PaperTextBoxStyle}" Width="80" />
                                    </StackPanel>

                                    <!-- CAPTURA TOTAL (Kg) -->
                                    <StackPanel Grid.Column="8">
                                        <TextBlock Text="CAPTURA TOTAL (Kg)" Style="{StaticResource PaperHeaderStyle}" />
                                        <Border Height="13" />
                                        <TextBox Text="{Binding CapturaTotalKg}" Style="{StaticResource PaperTextBoxStyle}" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                                    </StackPanel>
                                </Grid>

                                <Border Grid.Row="3" Height="20" />

                                <!-- FILA 3 DE LA PLANILLA PAPEL -->
                                <Grid Grid.Row="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" /> <!-- Arrastre -->
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="Auto" /> <!-- Malla -->
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="Auto" /> <!-- Cable -->
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="Auto" /> <!-- AbVert -->
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="Auto" /> <!-- DistA -->
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="*" />    <!-- DistP -->
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="Auto" /> <!-- Select -->
                                    </Grid.ColumnDefinitions>

                                    <!-- ARRASTRE -->
                                    <StackPanel>
                                        <TextBlock Text="ARRASTRE" Style="{StaticResource PaperHeaderStyle}" />
                                        <UniformGrid Columns="2">
                                            <StackPanel Margin="0,0,4,0">
                                                <Label Content="VEL" Style="{StaticResource PaperLabelStyle}" />
                                                <TextBox Text="{Binding VelocidadArrastreNudos}" Style="{StaticResource PaperTextBoxStyle}" Width="55" />
                                            </StackPanel>
                                            <StackPanel>
                                                <Label Content="RUMBO" Style="{StaticResource PaperLabelStyle}" />
                                                <TextBox Text="{Binding RumboGrados}" Style="{StaticResource PaperTextBoxStyle}" Width="55" />
                                            </StackPanel>
                                        </UniformGrid>
                                    </StackPanel>

                                    <!-- ABERT. MALLA -->
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="ABERT. MALLA" Style="{StaticResource PaperHeaderStyle}" />
                                        <UniformGrid Columns="2">
                                            <StackPanel Margin="0,0,4,0">
                                                <Label Content="COPO" Style="{StaticResource PaperLabelStyle}" />
                                                <TextBox Text="{Binding MallaCopoMm}" Style="{StaticResource PaperTextBoxStyle}" Width="55" />
                                            </StackPanel>
                                            <StackPanel>
                                                <Label Content="ALAS" Style="{StaticResource PaperLabelStyle}" />
                                                <TextBox Text="{Binding MallaAlasMm}" Style="{StaticResource PaperTextBoxStyle}" Width="55" />
                                            </StackPanel>
                                        </UniformGrid>
                                    </StackPanel>

                                    <!-- CABLE FIL. (m) -->
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="CABLE FIL. (m)" Style="{StaticResource PaperHeaderStyle}" />
                                        <Border Height="13" />
                                        <TextBox Text="{Binding CableFiladoM}" Style="{StaticResource PaperTextBoxStyle}" Width="80" />
                                    </StackPanel>

                                    <!-- ABERT. VERT (m) -->
                                    <StackPanel Grid.Column="6">
                                        <TextBlock Text="ABERT. VERT (m)" Style="{StaticResource PaperHeaderStyle}" />
                                        <Border Height="13" />
                                        <TextBox Text="{Binding AberturaVerticalM}" Style="{StaticResource PaperTextBoxStyle}" Width="90" />
                                    </StackPanel>

                                    <!-- DIST. ALAS (m) -->
                                    <StackPanel Grid.Column="8">
                                        <TextBlock Text="DIST. ALAS (m)" Style="{StaticResource PaperHeaderStyle}" />
                                        <Border Height="13" />
                                        <TextBox Text="{Binding DistanciaAlasM}" Style="{StaticResource PaperTextBoxStyle}" Width="90" />
                                    </StackPanel>

                                    <!-- DIST. PORTONES (m) -->
                                    <StackPanel Grid.Column="10">
                                        <TextBlock Text="DIST. PORTONES (m)" Style="{StaticResource PaperHeaderStyle}" />
                                        <Border Height="13" />
                                        <TextBox Text="{Binding DistanciaPortonesM}" Style="{StaticResource PaperTextBoxStyle}" />
                                    </StackPanel>

                                    <!-- SELECTIVIDAD -->
                                    <StackPanel Grid.Column="12" VerticalAlignment="Bottom">
                                        <CheckBox Content="Selectividad" IsChecked="{Binding Selectividad}" FontSize="11" Margin="0,0,0,8" VerticalAlignment="Bottom" />
                                    </StackPanel>
                                </Grid>

                                <Border Grid.Row="5" Height="10" />

                                <!-- FILA 4: COMENTARIOS -->
                                <Grid Grid.Row="6">
                                    <StackPanel>
                                        <TextBlock Text="COMENTARIOS / OBSERVACIONES" Style="{StaticResource PaperHeaderStyle}" />
                                        <TextBox Text="{Binding Comentarios}" 
                                                 Style="{StaticResource PaperTextBoxStyle}" 
                                                 Height="60" 
                                                 AcceptsReturn="True" 
                                                 TextWrapping="Wrap" 
                                                 VerticalScrollBarVisibility="Auto"
                                                 HorizontalContentAlignment="Left"
                                                 VerticalContentAlignment="Top"
                                                 Padding="8,4" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Tabla Especies -->
                        <Border Grid.Row="1" Style="{StaticResource SurfaceBorderStyle}" Padding="0" ClipToBounds="True">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Border Background="{DynamicResource SurfaceBackgroundBrush}" Padding="16,10" BorderBrush="{DynamicResource SidebarBorderBrush}" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <TextBlock Text="ESPECIES CAPTURADAS" Style="{StaticResource SectionHeaderStyle}" VerticalAlignment="Center" FontSize="11" />
                                        <Button HorizontalAlignment="Right" 
                                                Command="{Binding AddCatchItemCommand}"
                                                Style="{StaticResource ThemeButtonStyle}"
                                                Foreground="{DynamicResource AccentBrush}"
                                                Padding="12,6">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="+ " FontWeight="Bold" />
                                                <TextBlock Text="AÑADIR ESPECIE" FontSize="10" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>

                                <DataGrid Grid.Row="1" 
                                          ItemsSource="{Binding ItemsCaptura}" 
                                          SelectedItem="{Binding SelectedCatchItem}"
                                          Style="{StaticResource PremiumDataGridStyle}"
                                          IsReadOnly="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="ORD" Binding="{Binding NumeroOrden}" Width="40" ElementStyle="{StaticResource DataGridTextCenter}" />
                                        <DataGridTextColumn Header="ESPECIE" Binding="{Binding EspecieNombreVulgar}" Width="*" FontWeight="SemiBold" FontSize="13" ElementStyle="{StaticResource DataGridTextLeft}" />
                                        <DataGridTextColumn Header="CAPTURA" Binding="{Binding DatoCapturaDisplay}" Width="110" ElementStyle="{StaticResource DataGridTextRight}" HeaderStyle="{StaticResource PremiumDataGridColumnHeaderRightStyle}" />
                                        <DataGridTextColumn Header="DESC. (%)" Binding="{Binding DatoDescartePorcentajeDisplay}" Width="100" ElementStyle="{StaticResource DataGridTextRight}" HeaderStyle="{StaticResource PremiumDataGridColumnHeaderRightStyle}" Foreground="{DynamicResource SecondaryTextBrush}" />
                                        <DataGridTextColumn Header="DESC. (KG)" Binding="{Binding DatoDescarteKilosDisplay}" Width="110" ElementStyle="{StaticResource DataGridTextRight}" HeaderStyle="{StaticResource PremiumDataGridColumnHeaderRightStyle}" FontWeight="SemiBold" />
                                        <DataGridTemplateColumn Width="60">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Command="{Binding RemoveCommand}"
                                                            Content="✕"
                                                            Style="{StaticResource ThemeButtonStyle}"
                                                            Foreground="{DynamicResource DangerForegroundBrush}"
                                                            HorizontalAlignment="Center"
                                                            Padding="8,2"
                                                            FontSize="11" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <Border Grid.Row="2" Padding="20,10" Background="{DynamicResource SurfaceBackgroundBrush}" BorderBrush="{DynamicResource SidebarBorderBrush}" BorderThickness="0,1,0,0">
                                    <TextBlock Text="{Binding ItemsCaptura.Count, StringFormat='{}Total registros: {0}'}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" />
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Panel Lateral (Edición de Especie) -->
                    <Border Grid.Column="1" 
                            Width="340" 
                            Style="{StaticResource SurfaceBorderStyle}"
                            Background="{DynamicResource ShellBackgroundBrush}" 
                            Visibility="{Binding HasSelectedCatchItem, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border Background="{DynamicResource AccentMutedBrush}" Padding="24,20" BorderBrush="{DynamicResource SidebarBorderBrush}" BorderThickness="0,0,0,1">
                                <StackPanel>
                                    <TextBlock Text="EDITAR ESPECIE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                                    <TextBlock Text="{Binding SelectedCatchItem.EspecieNombreVulgar}" 
                                               FontSize="18" FontWeight="SemiBold" 
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               Margin="0,4,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <ScrollViewer Grid.Row="1" Style="{StaticResource SlimScrollViewerStyle}" Padding="24">
                                <StackPanel>
                                    <controls:SpeciesSelectorPremium 
                                        Label="Buscador de Especie"
                                        ItemsSource="{Binding AllEspecies}"
                                        SelectedItem="{Binding SelectedCatchItem.SelectedEspecie}"
                                        Margin="0,0,0,24" />

                                    <TextBlock Text="CAPTURA" FontWeight="Bold" FontSize="10" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,12"/>
                                    <Grid Margin="0,0,0,24">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="140" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding SelectedCatchItem.DatoCaptura}" Style="{StaticResource PremiumTextBoxStyle}" />
                                        <ComboBox Grid.Column="2"
                                                  ItemsSource="{Binding Source={StaticResource TipoDatoCapturaEnum}}"
                                                  SelectedItem="{Binding SelectedCatchItem.TipoDatoCaptura}"
                                                  Style="{StaticResource PremiumComboBoxStyle}" />
                                    </Grid>

                                    <TextBlock Text="DESCARTE" FontWeight="Bold" FontSize="10" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,12"/>
                                    <Grid Margin="0,0,0,24">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="140" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding SelectedCatchItem.DatoDescarte}" Style="{StaticResource PremiumTextBoxStyle}" />
                                        <ComboBox Grid.Column="2"
                                                  ItemsSource="{Binding Source={StaticResource TipoDatoDescarteEnum}}"
                                                  SelectedItem="{Binding SelectedCatchItem.TipoDatoDescarte}"
                                                  Style="{StaticResource PremiumComboBoxStyle}" />
                                    </Grid>
                                </StackPanel>
                            </ScrollViewer>

                            <Border Grid.Row="2" Padding="24" BorderBrush="{DynamicResource SidebarBorderBrush}" BorderThickness="0,1,0,0">
                                <Button Content="CERRAR EDICIÓN" 
                                        Click="CerrarEdicion_Click"
                                        Style="{StaticResource ThemeButtonStyle}"
                                        Foreground="{DynamicResource AccentBrush}"
                                        HorizontalAlignment="Stretch" FontSize="12" />
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <controls:FormActionBar Grid.Row="2"
                                        SaveCommand="{Binding SaveCommand}"
                                        CancelCommand="{Binding CancelCommand}"
                                        SaveContent="GUARDAR LANCE">
                    <controls:FormActionBar.AdditionalContent>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0">
                            <Button Content="Anterior" 
                                    Command="{Binding MovePreviousCommand}" 
                                    Style="{StaticResource ThemeButtonStyle}"
                                    Width="100" Margin="0,0,8,0"/>
                            <Button Content="Siguiente" 
                                    Command="{Binding MoveNextCommand}" 
                                    Style="{StaticResource ThemeButtonStyle}"
                                    Width="100"/>
                        </StackPanel>
                    </controls:FormActionBar.AdditionalContent>
                </controls:FormActionBar>
            </Grid>
        </Border>
    </AdornerDecorator>
</UserControl>
