<UserControl x:Class="ControlMareas.App.Views.MareaEditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ControlMareas.App.Views"
             xmlns:vm="clr-namespace:ControlMareas.App.ViewModels"
             xmlns:controls="clr-namespace:ControlMareas.App.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1000">
    <UserControl.InputBindings>
        <KeyBinding Key="Esc" Command="{Binding CancelCommand}" />
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding AddEtapaCommand}" />
    </UserControl.InputBindings>
    <AdornerDecorator>
        <Border Background="{DynamicResource ShellBackgroundBrush}"
                Padding="40"
                CornerRadius="0"
                MaxWidth="960"
                VerticalAlignment="Center"
                BorderBrush="{DynamicResource SidebarBorderBrush}"
                BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="50" Color="Black" Opacity="0.3" ShadowDepth="10" />
            </Border.Effect>
            
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Margin="0,0,0,32">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel>
                        <TextBlock Text="EDICIÓN DE MAREA"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBrush}" />
                        <TextBlock Text="Datos Generales y Etapas"
                                   FontSize="28"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   Margin="0,4,0,0" />
                    </StackPanel>

                </Grid>

                <!-- Body -->
                <ScrollViewer Grid.Row="1" Style="{StaticResource SlimScrollViewerStyle}" Padding="0,0,20,0">
                    <StackPanel>
                        <!-- Seccion Marea -->
                        <Border Style="{StaticResource SurfaceBorderStyle}" Padding="24" Margin="0,0,0,24">
                            <StackPanel>
                                <TextBlock Text="DATOS DE LA MAREA" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,20" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="20" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Fila 1 -->
                                    <StackPanel>
                                        <Label Content="Año Inidep" Style="{StaticResource FormLabelStyle}" />
                                        <TextBox x:Name="AnioInput" Text="{Binding AnioInidep}" Style="{StaticResource PremiumTextBoxStyle}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <Label Content="Número Inidep" Style="{StaticResource FormLabelStyle}" />
                                        <TextBox Text="{Binding NumeroInidep}" Style="{StaticResource PremiumTextBoxStyle}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="4">
                                        <Label Content="Código (calculado)" Style="{StaticResource FormLabelStyle}" />
                                        <TextBox Text="{Binding CodigoDisplay, Mode=OneWay}" 
                                                 Style="{StaticResource PremiumTextBoxStyle}" 
                                                 IsReadOnly="True" 
                                                 Focusable="False" 
                                                 Background="Transparent"
                                                 BorderBrush="Transparent"
                                                 Opacity="0.7" />
                                    </StackPanel>

                                    <!-- Fila 2 -->
                                    <StackPanel Grid.Row="2">
                                        <Label Content="Buque" Style="{StaticResource FormLabelStyle}" />
                                        <ComboBox ItemsSource="{Binding Buques}"
                                                  DisplayMemberPath="Nombre"
                                                  SelectedItem="{Binding SelectedBuque}"
                                                  Style="{StaticResource PremiumComboBoxStyle}" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="2" Grid.Column="2">
                                        <Label Content="Fecha Inicio" Style="{StaticResource FormLabelStyle}" />
                                        <controls:DatePickerPremium SelectedDate="{Binding FechaInicio}" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="2" Grid.Column="4">
                                        <Label Content="Fecha Fin" Style="{StaticResource FormLabelStyle}" />
                                        <controls:DatePickerPremium SelectedDate="{Binding FechaFin}" />
                                    </StackPanel>
                                </Grid>
                                
                                <StackPanel Margin="0,20,0,0">
                                    <Label Content="Comentarios" Style="{StaticResource FormLabelStyle}" />
                                    <TextBox Text="{Binding Comentarios}" 
                                             Style="{StaticResource PremiumTextBoxStyle}" 
                                             MinHeight="80" 
                                             AcceptsReturn="True" 
                                             TextWrapping="Wrap" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Seccion Etapas -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="ETAPAS OPERATIVAS (Timeline)" Style="{StaticResource SectionHeaderStyle}" VerticalAlignment="Center" />
                            <Button Grid.Column="1" 
                                    Command="{Binding AddEtapaCommand}" 
                                    Content="+ Añadir Etapa" 
                                    Style="{StaticResource ThemeButtonStyle}" 
                                    Foreground="{DynamicResource AccentBrush}" />
                        </Grid>

                        <ItemsControl ItemsSource="{Binding Etapas}" Margin="0,16,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="32" /> <!-- Linea timeline -->
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        
                                        <!-- Linea Vertical -->
                                        <Rectangle Width="2" 
                                                   Fill="{DynamicResource SidebarBorderBrush}" 
                                                   HorizontalAlignment="Center"
                                                   Grid.RowSpan="2"
                                                   Margin="0,0,0,-12" />
                                        
                                        <!-- Punto -->
                                        <Ellipse Width="12" Height="12" 
                                                 Fill="{DynamicResource AccentBrush}" 
                                                 VerticalAlignment="Top" 
                                                 Margin="0,16,0,0" />

                                        <Border Grid.Column="1" 
                                                Style="{StaticResource SurfaceBorderStyle}" 
                                                Padding="0" 
                                                ClipToBounds="True">
                                            <StackPanel>
                                                <!-- Header Etapa (Clickable) -->
                                                <Button Command="{Binding ToggleExpandedCommand}" 
                                                        Style="{StaticResource ThemeButtonStyle}"
                                                        HorizontalContentAlignment="Stretch"
                                                        Padding="20,15"
                                                        BorderThickness="0"
                                                        Background="Transparent">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="30" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding SummaryText}" 
                                                                   FontWeight="SemiBold" 
                                                                   Foreground="{DynamicResource PrimaryTextBrush}" />

                                                        <Button Grid.Column="1"
                                                                Command="{Binding RemoveCommand}"
                                                                Content="✕"
                                                                ToolTip="Eliminar etapa"
                                                                Style="{StaticResource ThemeButtonStyle}"
                                                                Foreground="#FF5252"
                                                                Padding="10,0"
                                                                FontSize="14"
                                                                VerticalAlignment="Center" />

                                                        <TextBlock Grid.Column="3" FontWeight="Bold" VerticalAlignment="Center">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Text" Value="▶" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                                            <Setter Property="Text" Value="▼" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Grid>
                                                </Button>

                                                <!-- Content Etapa (Collapsible) -->
                                                <Border Visibility="{Binding IsExpanded, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                        Padding="20,0,20,20"
                                                        BorderBrush="{DynamicResource SidebarBorderBrush}"
                                                        BorderThickness="0,1,0,0">
                                                    <Grid Margin="0,20,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="15" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="15" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="15" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>

                                                        <StackPanel>
                                                            <Label Content="Fecha Zarpada" Style="{StaticResource FormLabelStyle}" />
                                                            <controls:DatePickerPremium SelectedDate="{Binding FechaZarpada}" Loaded="EtapaDatePicker_Loaded" />
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="2">
                                                            <Label Content="Fecha Arribo" Style="{StaticResource FormLabelStyle}" />
                                                            <controls:DatePickerPremium SelectedDate="{Binding FechaArribo}" />
                                                        </StackPanel>

                                                        <StackPanel Grid.Row="2" Grid.ColumnSpan="3">
                                                            <Label Content="Capitán" Style="{StaticResource FormLabelStyle}" />
                                                            <TextBox Text="{Binding NombreCapitan}" Style="{StaticResource PremiumTextBoxStyle}" />
                                                        </StackPanel>

                                                        <StackPanel Grid.Row="4">
                                                            <Label Content="Oficial Cubierta" Style="{StaticResource FormLabelStyle}" />
                                                            <TextBox Text="{Binding NombreOficialCubierta}" Style="{StaticResource PremiumTextBoxStyle}" />
                                                        </StackPanel>

                                                        <StackPanel Grid.Row="4" Grid.Column="2">
                                                            <Label Content="Oficial Pesca" Style="{StaticResource FormLabelStyle}" />
                                                            <TextBox Text="{Binding NombreOficialPesca}" Style="{StaticResource PremiumTextBoxStyle}" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <controls:FormActionBar Grid.Row="2" 
                                        CancelCommand="{Binding CancelCommand}" 
                                        SaveCommand="{Binding SaveCommand}"
                                        SaveContent="Guardar Marea">
                    <Button Command="{Binding ImportDbfCommand}"
                            Content="Importar (JSON/DBF)"
                            Style="{StaticResource ThemeButtonStyle}"
                            Foreground="{DynamicResource AccentBrush}"
                            Padding="20,10" />
                </controls:FormActionBar>
            </Grid>
        </Border>
    </AdornerDecorator>
</UserControl>
