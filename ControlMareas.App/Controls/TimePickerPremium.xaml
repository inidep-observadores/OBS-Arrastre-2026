<UserControl x:Class="ControlMareas.App.Controls.TimePickerPremium"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             Focusable="True"
             IsTabStop="False"
             KeyboardNavigation.TabNavigation="Continue"
             GotFocus="UserControl_GotFocus"
             d:DesignHeight="40" d:DesignWidth="150">
    <Grid>
        <Border x:Name="MainBorder"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1.5"
                CornerRadius="0"
                SnapsToDevicePixels="True">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsFocused, ElementName=TimeInput}" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            <Setter Property="BorderThickness" Value="2"/>
                            <Setter Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect BlurRadius="8" ShadowDepth="0" Color="{Binding Color, Source={StaticResource AccentBrush}}" Opacity="0.3"/>
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding EsCompacto, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                            <Setter Property="Padding" Value="0"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox x:Name="TimeInput"
                         Background="Transparent"
                         BorderThickness="0"
                         FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                         Foreground="{DynamicResource PrimaryTextBrush}"
                         CaretBrush="{DynamicResource AccentBrush}"
                         VerticalContentAlignment="Center"
                         TextChanged="TimeInput_TextChanged"
                         PreviewKeyDown="TimeInput_PreviewKeyDown"
                         LostFocus="TimeInput_LostFocus"
                         MaxLength="5">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Setter Property="Padding" Value="12,8" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding EsCompacto, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                    <Setter Property="Padding" Value="6,4" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>

                <Viewbox Grid.Column="1" 
                        Width="16" 
                        Height="16" 
                        VerticalAlignment="Center"
                        IsHitTestVisible="False">
                    <Viewbox.Style>
                        <Style TargetType="Viewbox">
                            <Setter Property="Margin" Value="0,0,10,0" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding EsCompacto, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                    <Setter Property="Margin" Value="0,0,5,0" />
                                    <Setter Property="Width" Value="14" />
                                    <Setter Property="Height" Value="14" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Viewbox.Style>
                    <Path Data="M12,20A8,8 0 0,0 20,12A8,8 0 0,0 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20M12,2A10,10 0 0,1 22,12A10,10 0 0,1 12,22C6.47,22 2,17.5 2,12A10,10 0 0,1 12,2M12.5,7V12.25L17,14.92L16.25,16.15L11,13V7H12.5Z"
                          Fill="{DynamicResource SecondaryTextBrush}"/>
                </Viewbox>
            </Grid>
        </Border>
    </Grid>
</UserControl>
